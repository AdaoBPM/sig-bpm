// =============================================================================
// SIG BPM — Fechamento Mensal
//
// Banco de DESENVOLVIMENTO: SQLite (arquivo local, ver prisma.config.ts).
// Banco de PRODUÇÃO: PostgreSQL.
//
// Este schema é escrito para ser portável entre os dois. As convenções que
// garantem isso — e o que muda na migração — estão em prisma/PORTABILIDADE.md.
// Leia aquele arquivo antes de acrescentar campos.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // MIGRAÇÃO PARA POSTGRES: trocar para "postgresql" e ajustar a URL em
  // prisma.config.ts. Nenhuma outra linha deste schema precisa mudar.
  provider = "sqlite"
}

// -----------------------------------------------------------------------------
// Usuário e auditoria (herdados do molde repositorio-padrao-bpm)
// -----------------------------------------------------------------------------

/// ENUM: perfil de acesso. Governa o que o usuário vê e faz (RF001 do SPEC).
enum PerfilUsuario {
  CONTABIL
  ALIMENTADOR
  GESTAO
}

model Usuario {
  id           String        @id @default(uuid())
  nome         String
  email        String        @unique
  senhaHash    String        @map("senha_hash")
  perfil       PerfilUsuario @default(GESTAO)
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem        Int           @default(0)
  ativo        Boolean       @default(true)
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")

  /// LISTA: substitui o campo `permissions String[]` do molde.
  permissoes UsuarioPermissao[]
  /// LISTA: quais listas operacionais este Alimentador pode preencher.
  setores    UsuarioSetor[]

  competenciasAbertas   Competencia[] @relation("CompetenciaAberta")
  competenciasApuradas  Competencia[] @relation("CompetenciaApurada")
  competenciasFechadas  Competencia[] @relation("CompetenciaFechada")
  reaberturas           ReaberturaCompetencia[]
  importacoes           Importacao[]

  @@map("usuarios")
}

/// LISTA-DE: Usuario.setores
///
/// Quais tipos de lista o Alimentador pode preencher. Reaproveita
/// `TipoImportacao` porque o recorte de permissão é exatamente por tipo de lista.
model UsuarioSetor {
  usuarioId String         @map("usuario_id")
  tipoLista TipoImportacao @map("tipo_lista")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, tipoLista])
  @@index([tipoLista])
  @@map("usuario_setores")
}

/// LISTA-DE: Usuario.permissions (era `String[]` no molde)
///
/// O SQLite não suporta lista de tipo primitivo no Prisma. Em vez de serializar
/// em texto, a lista virou tabela de relação — que funciona igual nos dois
/// bancos e ainda permite indexar e consultar por permissão.
/// Na migração para PostgreSQL esta tabela é mantida como está.
model UsuarioPermissao {
  usuarioId String @map("usuario_id")
  permissao String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, permissao])
  @@index([permissao])
  @@map("usuario_permissoes")
}

model AuditLog {
  id          String   @id @default(uuid())
  acao        String
  entidade    String?
  entidadeId  String?  @map("entidade_id")
  usuarioId   String?  @map("usuario_id")
  usuarioNome String?  @map("usuario_nome")
  ip          String?
  userAgent   String?  @map("user_agent")
  /// JSON: suportado nos dois bancos. Em SQLite o Prisma serializa e valida.
  dadosAntes  Json?    @map("dados_antes")
  dadosDepois Json?    @map("dados_depois")
  metadados   Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([usuarioId, createdAt(sort: Desc)])
  @@index([entidade, entidadeId])
  @@map("audit_log")
}

// =============================================================================
// CADASTROS DE PARAMETRIZAÇÃO (Passo 2)
//
// São os dados que o Contábil mantém e que governam a classificação e o rateio.
// Correspondem hoje às abas `Centros de Custo`, `Contas de Resultado`,
// `Tipos de Movimento`, `Tabela de Estacas` e à estrutura do
// `Realizado (Consolidado)` do arquivo UNIDADES E CENTROS DE CUSTO.
//
// REGRA GERAL DOS CADASTROS
// Todo cadastro tem `id` (chave interna) e `ordem` (posição na tela, que o
// usuário reorganiza subindo e descendo itens). A `ordem` é apresentação e muda
// a qualquer momento — por isso NÃO é única e NENHUMA regra de negócio se apoia
// nela. Referência entre registros usa `id` ou um `codigo` estável.
// =============================================================================

/// ENUM: natureza da unidade, define como ela é apurada.
enum TipoUnidade {
  MATRIZ
  FILIAL
  SERVICOS
  DESPESAS
  RN
}

/// ENUM: nível da conta no plano de contas do ERP. Só ANALITICA classifica.
enum TipoConta {
  SINTETICA
  ANALITICA
}

/// ENUM: sinal com que a conta entra no balancete.
/// Na planilha aparece como "+" e "-" na coluna SINAL BAL.
enum SinalBalancete {
  POSITIVO
  NEGATIVO
}

/// ENUM: papel da linha na estrutura da DRE.
/// ITEM soma lançamentos; SUBTOTAL e TOTAL são calculados por `expressao`.
enum TipoLinhaDRE {
  ITEM
  SUBTOTAL
  TOTAL
}

/// ENUM: se o custo do centro de custo é direto ou indireto.
/// Vem da coluna ATRIBUIÇÃO da aba `Centros de Custo`.
enum AtribuicaoCusto {
  DIRETA
  INDIRETA
}

/// ENUM: chave de rateio. Custos marcados com uma destas chaves são
/// distribuídos entre unidades conforme o volume físico da competência.
enum ChaveRateio {
  PROJETO
  PRODUCAO
  METALURGIA
  ARMADURA
  ACOMPANHAMENTO
}

/// ENUM: grandeza física que serve de direcionador do rateio.
enum BaseFisica {
  M3
  KG
  PISTA
  DIA
}

model UnidadeNegocio {
  id        String      @id @default(uuid())
  codigo    Int         @unique
  nome      String
  tipo      TipoUnidade
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem     Int         @default(0)
  ativo     Boolean     @default(true)
  criadoEm  DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  centrosCusto   CentroCusto[]
  regrasRateio   RegraRateio[]
  /// LISTA: linhas da DRE que se aplicam a esta unidade.
  linhasDRE      LinhaDREUnidade[]
  obras          Obra[]

  projetos            Projeto[]
  producoes           Producao[]
  producoesPista      ProducaoPista[]
  producoesArmadura   ProducaoArmadura[]
  producoesMetalurgia ProducaoMetalurgia[]
  expedicoes          Expedicao[]
  montagens           Montagem[]
  acompanhamentos     Acompanhamento[]
  medicoes            Medicao[]
  devolucoes          Devolucao[]
  saidas              Saida[]
  faturamentos        Faturamento[]
  obrasEncerradas     ObraEncerrada[]

  @@map("unidades_negocio")
}

model CentroCusto {
  id                String          @id @default(uuid())
  coligada          Int
  /// Chave de conciliação com o TOTVS RM.
  codigoRM          String          @unique @map("codigo_rm")
  nomeRM            String          @map("nome_rm")
  /// Nome adotado pela controladoria; agrupa vários centros sob um mesmo rótulo.
  nomeControladoria String?         @map("nome_controladoria")
  departamento      String
  departamentoSigla String          @map("departamento_sigla")
  atribuicao        AtribuicaoCusto
  atribuicaoSigla   String          @map("atribuicao_sigla")
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem             Int             @default(0)
  ativo             Boolean         @default(true)
  criadoEm          DateTime        @default(now()) @map("criado_em")
  atualizadoEm      DateTime        @updatedAt @map("atualizado_em")

  chaveRateio      ChaveRateio? @map("chave_rateio")
  unidadeNegocioId String?      @map("unidade_negocio_id")

  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])

  lancamentosContabeis LancamentoContabil[]
  lancamentosManuais   LancamentoManual[]

  @@index([nomeControladoria])
  @@index([chaveRateio])
  @@map("centros_custo")
}

model ContaResultado {
  id             String         @id @default(uuid())
  /// Código reduzido no ERP — chave de conciliação do balancete.
  reduzido       Int            @unique
  /// Código hierárquico, ex.: 3.02.01.03.01.01
  conta          String
  descricao      String
  tipoConta      TipoConta      @map("tipo_conta")
  departamento   String?
  /// Subgrupo na DRE, ex.: "Receita Bruta de Montagem". Não confundir com a
  /// ATRIBUIÇÃO do centro de custo, que é direta/indireta — ver PORTABILIDADE.md.
  atribuicao     String?
  sinalBalancete SinalBalancete? @map("sinal_balancete")
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem          Int            @default(0)
  ativo          Boolean        @default(true)
  criadoEm       DateTime       @default(now()) @map("criado_em")
  atualizadoEm   DateTime       @updatedAt @map("atualizado_em")

  chaveRateio ChaveRateio? @map("chave_rateio")
  linhaDREId  String?      @map("linha_dre_id")

  linhaDRE LinhaDRE? @relation(fields: [linhaDREId], references: [id])

  lancamentosContabeis LancamentoContabil[]
  lancamentosManuais   LancamentoManual[]

  @@index([conta])
  @@index([linhaDREId])
  @@map("contas_resultado")
}

/// A estrutura da DRE é dado, não código (RF003 do SPEC).
model LinhaDRE {
  id              String       @id @default(uuid())
  /// Código estável e legível da linha, ex.: "ROL", "CPV", "CPP.MOD.CLT".
  /// É por ele que as expressões de subtotal referenciam outras linhas —
  /// nunca pela `ordem`, que o usuário reorganiza na tela.
  codigo          String       @unique
  /// ORDEM: posição na DRE, reorganizável pelo usuário. Apresentação apenas.
  ordem           Int          @default(0)
  grupo           String
  grupoSigla      String       @map("grupo_sigla")
  atribuicao      String?
  atribuicaoSigla String?      @map("atribuicao_sigla")
  descricao       String
  tipo            TipoLinhaDRE
  /// Fórmula do subtotal, referenciando outras linhas pelo `codigo`,
  /// ex.: "ROL - CPV". Nulo quando `tipo` é ITEM.
  expressao       String?
  /// O que a linha significa — vem da coluna de definição da planilha.
  definicao       String?
  ativo           Boolean      @default(true)
  criadoEm        DateTime     @default(now()) @map("criado_em")
  atualizadoEm    DateTime     @updatedAt @map("atualizado_em")

  contas    ContaResultado[]
  /// LISTA: em quais unidades esta linha aparece.
  unidades  LinhaDREUnidade[]

  lancamentosContabeis LancamentoContabil[]
  lancamentosManuais   LancamentoManual[]

  @@index([grupoSigla])
  @@map("linhas_dre")
}

/// LISTA-DE: LinhaDRE.unidadesAplicaveis (seria `String[]` no PostgreSQL)
///
/// Convertida em tabela de relação por duas razões: o SQLite não suporta lista
/// escalar, e aqui a lista é de referências a UnidadeNegocio — então a relação
/// dá integridade referencial que um array de texto não daria.
model LinhaDREUnidade {
  linhaDREId       String @map("linha_dre_id")
  unidadeNegocioId String @map("unidade_negocio_id")

  linhaDRE       LinhaDRE       @relation(fields: [linhaDREId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio @relation(fields: [unidadeNegocioId], references: [id], onDelete: Cascade)

  @@id([linhaDREId, unidadeNegocioId])
  @@index([unidadeNegocioId])
  @@map("linhas_dre_unidades")
}

/// Direcionador de rateio. O percentual NÃO é cadastrado — é calculado por
/// competência a partir do volume físico realizado (RF007 do SPEC).
model RegraRateio {
  id               String      @id @default(uuid())
  chave            ChaveRateio
  unidadeDestinoId String      @map("unidade_destino_id")
  baseFisica       BaseFisica  @map("base_fisica")
  /// Qual lista operacional fornece o volume, ex.: "Producao", "ProducaoMetalurgia".
  origemDoVolume   String      @map("origem_do_volume")
  vigenciaInicio   DateTime    @map("vigencia_inicio")
  vigenciaFim      DateTime?   @map("vigencia_fim")
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem            Int         @default(0)
  criadoEm         DateTime    @default(now()) @map("criado_em")
  atualizadoEm     DateTime    @updatedAt @map("atualizado_em")

  unidadeDestino UnidadeNegocio @relation(fields: [unidadeDestinoId], references: [id])

  @@unique([chave, unidadeDestinoId, vigenciaInicio])
  @@index([chave])
  @@map("regras_rateio")
}

model TipoMovimento {
  id             String   @id @default(uuid())
  /// Código do movimento no ERP, ex.: 1.2.18
  codigo         String   @unique
  descricao      String
  retornaEstoque Boolean  @map("retorna_estoque")
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem          Int      @default(0)
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  devolucoes   Devolucao[]
  saidas       Saida[]
  faturamentos Faturamento[]

  @@map("tipos_movimento")
}

model TabelaEstaca {
  id             String    @id @default(uuid())
  secao          String
  grupo          String
  /// DECIMAL: aritmética sempre em JavaScript, nunca em SQL cru.
  /// Ver a ressalva de precisão do SQLite em PORTABILIDADE.md.
  precoUnitario  Decimal   @map("preco_unitario")
  vigenciaInicio DateTime  @map("vigencia_inicio")
  vigenciaFim    DateTime? @map("vigencia_fim")
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem          Int       @default(0)
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  @@unique([secao, grupo, vigenciaInicio])
  @@map("tabela_estacas")
}

// =============================================================================
// GOVERNANÇA DA APURAÇÃO (Passo 3)
//
// Competência, importação, divergência e auditoria. É aqui que mora o
// Princípio de Congelamento da Apuração descrito no SPEC.md: apurar grava o
// retrato do mês e o congela; só a reabertura permite nova apuração.
// =============================================================================

/// ENUM: estado da competência.
/// ABERTA → EM_CONFERENCIA → FECHADA, e FECHADA → ABERTA por reabertura.
enum StatusCompetencia {
  ABERTA
  EM_CONFERENCIA
  FECHADA
}

/// ENUM: tipo de arquivo ou lista que entra no sistema.
/// Serve tanto para `Importacao.tipo` quanto para dizer quais listas um
/// Alimentador pode preencher (`UsuarioSetor.tipoLista`).
enum TipoImportacao {
  BALANCETE
  FOLHA
  REQUISICOES
  NOTAS_FISCAIS
  DRE_COMERCIAL
  ESTOQUE_INICIAL
  PROJETO
  PRODUCAO
  PRODUCAO_PISTA
  PRODUCAO_ARMADURA
  PRODUCAO_METALURGIA
  EXPEDICAO
  MONTAGEM
  ACOMPANHAMENTO
  MEDICAO
  DEVOLUCAO
  SAIDA
  FATURAMENTO
  OBRA_ENCERRADA
}

/// ENUM: estado do processamento de uma importação.
enum StatusImportacao {
  PROCESSANDO
  CONCLUIDA
  REJEITADA
}

/// ENUM: o que originou a divergência retroativa (RF010 do SPEC).
enum TipoDivergencia {
  BALANCETE
  PRECO_CONTRATO
}

/// ENUM: tratamento dado à divergência.
enum StatusDivergencia {
  ABERTA
  JUSTIFICADA
  RESOLVIDA_POR_REABERTURA
}

model Competencia {
  id     String            @id @default(uuid())
  ano    Int
  mes    Int
  status StatusCompetencia @default(ABERTA)

  abertaEm   DateTime @default(now()) @map("aberta_em")
  abertaPor  String   @map("aberta_por")
  /// Última apuração. Nulo enquanto o mês não foi apurado.
  apuradaEm  DateTime? @map("apurada_em")
  apuradaPor String?   @map("apurada_por")
  /// Quantas vezes o mês foi apurado — reapurar é normal durante a conferência.
  apuracoes  Int       @default(0) @map("apuracoes")
  fechadaEm  DateTime? @map("fechada_em")
  fechadaPor String?   @map("fechada_por")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  usuarioAbertura  Usuario  @relation("CompetenciaAberta", fields: [abertaPor], references: [id])
  usuarioApuracao  Usuario? @relation("CompetenciaApurada", fields: [apuradaPor], references: [id])
  usuarioFechamento Usuario? @relation("CompetenciaFechada", fields: [fechadaPor], references: [id])

  /// LISTA: histórico de reaberturas, uma por ocorrência.
  historicoReaberturas ReaberturaCompetencia[]
  importacoes          Importacao[]
  divergencias         Divergencia[]

  lancamentosContabeis LancamentoContabil[]
  lancamentosManuais   LancamentoManual[]
  estoqueSaldos        EstoqueSaldo[]

  projetos            Projeto[]
  producoes           Producao[]
  producoesPista      ProducaoPista[]
  producoesArmadura   ProducaoArmadura[]
  producoesMetalurgia ProducaoMetalurgia[]
  expedicoes          Expedicao[]
  montagens           Montagem[]
  acompanhamentos     Acompanhamento[]
  medicoes            Medicao[]
  devolucoes          Devolucao[]
  saidas              Saida[]
  faturamentos        Faturamento[]
  obrasEncerradas     ObraEncerrada[]

  @@unique([ano, mes])
  @@index([status])
  @@map("competencias")
}

/// Cada reabertura é um registro próprio, com justificativa e autor.
/// Guardar o histórico completo é o que permite auditar um mês reapurado
/// várias vezes — um contador só diria quantas, não por quê.
model ReaberturaCompetencia {
  id            String   @id @default(uuid())
  competenciaId String   @map("competencia_id")
  justificativa String
  reabertaEm    DateTime @default(now()) @map("reaberta_em")
  reabertaPor   String   @map("reaberta_por")

  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  usuario     Usuario     @relation(fields: [reabertaPor], references: [id])

  @@index([competenciaId, reabertaEm])
  @@map("reaberturas_competencia")
}

model Importacao {
  id              String           @id @default(uuid())
  competenciaId   String           @map("competencia_id")
  tipo            TipoImportacao
  nomeArquivo     String           @map("nome_arquivo")
  /// Impressão digital do conteúdo — impede reprocessar o mesmo arquivo por engano.
  hashArquivo     String           @map("hash_arquivo")
  importadoPor    String           @map("importado_por")
  importadoEm     DateTime         @default(now()) @map("importado_em")
  linhasLidas     Int              @default(0) @map("linhas_lidas")
  linhasAceitas   Int              @default(0) @map("linhas_aceitas")
  linhasRejeitadas Int             @default(0) @map("linhas_rejeitadas")
  status          StatusImportacao @default(PROCESSANDO)
  /// JSON: erros por linha, para o relatório de importação.
  relatorioErros  Json?            @map("relatorio_erros")
  /// Uma reimportação do mesmo tipo na mesma competência substitui a anterior,
  /// que fica marcada aqui em vez de ser apagada.
  substituidaEm   DateTime?        @map("substituida_em")

  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  usuario     Usuario     @relation(fields: [importadoPor], references: [id])

  divergencias         Divergencia[]
  lancamentosContabeis LancamentoContabil[]

  @@index([competenciaId, tipo])
  @@index([hashArquivo])
  @@map("importacoes")
}

/// Divergência retroativa: dado novo que conflita com o que já foi apurado ou
/// fechado. Registrar NUNCA altera a competência (RF010 do SPEC).
model Divergencia {
  id            String            @id @default(uuid())
  competenciaId String            @map("competencia_id")
  tipo          TipoDivergencia
  importacaoId  String            @map("importacao_id")

  /// Preenchidos quando `tipo` é BALANCETE.
  contaResultadoId String? @map("conta_resultado_id")
  centroCustoId    String? @map("centro_custo_id")
  /// Preenchido quando `tipo` é PRECO_CONTRATO.
  /// A relação com Obra é criada no Passo 4, quando o modelo existir.
  obraId           String? @map("obra_id")

  /// DECIMAL: aritmética sempre em JavaScript. Ver PORTABILIDADE.md.
  valorGravado  Decimal           @map("valor_gravado")
  valorRecebido Decimal           @map("valor_recebido")
  diferenca     Decimal
  detectadaEm   DateTime          @default(now()) @map("detectada_em")
  status        StatusDivergencia @default(ABERTA)
  justificativa String?
  tratadaEm     DateTime?         @map("tratada_em")
  tratadaPor    String?           @map("tratada_por")

  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  importacao  Importacao  @relation(fields: [importacaoId], references: [id])
  obra        Obra?       @relation(fields: [obraId], references: [id])

  @@index([competenciaId, status])
  @@index([status])
  @@map("divergencias")
}

// =============================================================================
// MOVIMENTO (Passo 4)
//
// O que entra por importação ou digitação em cada competência: obras, preços
// de contrato, lançamentos contábeis e manuais, as listas operacionais e o
// saldo de estoque.
// =============================================================================

/// ENUM: modalidade de venda da obra.
enum TipoVenda {
  GLOBAL
  MERCANTIL
}

/// ENUM: situação do cadastro da obra, apurada na importação.
/// GENERICA são os estoques de acabados sem projeto vendido (G11, M2, M3, M9999),
/// precificados por tabela. SEM_CONTRATO e INCONSISTENTE são pendências a reportar.
enum SituacaoCadastroObra {
  OK
  SEM_CONTRATO
  GENERICA
  INCONSISTENTE
}

/// ENUM: se o lançamento vai direto para uma unidade ou é rateado.
enum TipoAlocacao {
  DIRETO
  RATEIO
}

/// ENUM: resultado da checagem de classificação do lançamento (RF006 do SPEC).
/// Qualquer valor diferente de OK impede o fechamento da competência.
enum ValidacaoLancamento {
  OK
  ERRO_DEPARTAMENTO
  ERRO_ATRIBUICAO
  SEM_DESTINO
}

/// ENUM: unidade de medida das listas operacionais.
enum UnidadeMedida {
  M3
  M2
  M
  KG
  PISTA
  DIA
  UND
}

model Obra {
  id               String               @id @default(uuid())
  codigo           String               @unique
  nome             String
  unidadeNegocioId String?              @map("unidade_negocio_id")
  linha            String?
  tipoVenda        TipoVenda?           @map("tipo_venda")
  /// Estoque de acabados sem projeto vendido — precificado por tabela.
  generica         Boolean              @default(false)
  situacaoCadastro SituacaoCadastroObra @default(OK) @map("situacao_cadastro")
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem            Int                  @default(0)
  criadoEm         DateTime             @default(now()) @map("criado_em")
  atualizadoEm     DateTime             @updatedAt @map("atualizado_em")

  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])

  precos        PrecoContrato[]
  estoques      EstoqueSaldo[]
  divergencias  Divergencia[]

  projetos            Projeto[]
  producoes           Producao[]
  producoesPista      ProducaoPista[]
  producoesArmadura   ProducaoArmadura[]
  producoesMetalurgia ProducaoMetalurgia[]
  expedicoes          Expedicao[]
  montagens           Montagem[]
  acompanhamentos     Acompanhamento[]
  medicoes            Medicao[]
  devolucoes          Devolucao[]
  saidas              Saida[]
  faturamentos        Faturamento[]
  obrasEncerradas     ObraEncerrada[]

  @@index([situacaoCadastro])
  @@map("obras")
}

/// Preço de contrato vindo da aba `DRE` do CONTROLE DAS VENDAS.
/// HISTORIADO, não sobrescrito: uma reimportação marca o anterior como
/// substituído e cria o novo, para que a receita de competências já apuradas
/// continue explicável. Ver o Princípio de Congelamento no SPEC.md.
model PrecoContrato {
  id             String   @id @default(uuid())
  obraId         String   @map("obra_id")
  versao         Int
  linha          String
  /// Natureza da receita, ex.: "Receita Bruta do Pré-Fabricado".
  contaResultado String   @map("conta_resultado")
  /// DECIMAL: aritmética sempre em JavaScript. Ver PORTABILIDADE.md.
  valorUnitario  Decimal  @map("valor_unitario")
  valorTotal     Decimal  @map("valor_total")
  etapa          String?
  importacaoId   String?  @map("importacao_id")
  vigenteDesde   DateTime @default(now()) @map("vigente_desde")
  substituidoEm  DateTime? @map("substituido_em")

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId, versao])
  @@index([substituidoEm])
  @@map("precos_contrato")
}

/// Lançamento do balancete. É IMUTÁVEL — divergência de classificação se
/// corrige no cadastro e se reflete aqui na próxima apuração.
/// O valor gravado é a MOVIMENTAÇÃO DO MÊS, não o saldo da conta.
model LancamentoContabil {
  id            String @id @default(uuid())
  competenciaId String @map("competencia_id")
  importacaoId  String @map("importacao_id")
  filial        Int
  centroCustoId String? @map("centro_custo_id")
  contaResultadoId String @map("conta_resultado_id")
  /// DECIMAL: movimentação do mês.
  valorMovimento Decimal @map("valor_movimento")

  // --- campos derivados, recalculados a cada apuração e congelados com ela ---
  departamento String?
  atribuicao   String?
  linhaDREId   String?              @map("linha_dre_id")
  chaveRateio  ChaveRateio?         @map("chave_rateio")
  alocacao     TipoAlocacao?
  /// Chave de agregação: departamento.atribuicao.conta, prefixada pelo rateio
  /// quando houver. É o equivalente da coluna ETIQUETA da planilha.
  etiqueta     String?
  validacao    ValidacaoLancamento  @default(OK)

  criadoEm DateTime @default(now()) @map("criado_em")

  competencia    Competencia    @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  importacao     Importacao     @relation(fields: [importacaoId], references: [id])
  centroCusto    CentroCusto?   @relation(fields: [centroCustoId], references: [id])
  contaResultado ContaResultado @relation(fields: [contaResultadoId], references: [id])
  linhaDRE       LinhaDRE?      @relation(fields: [linhaDREId], references: [id])

  @@index([competenciaId, validacao])
  @@index([competenciaId, etiqueta])
  @@index([competenciaId, filial])
  @@map("lancamentos_contabeis")
}

/// Lançamento que não vem do ERP — hoje é o canal da RN, cujas movimentações
/// não são lançadas no TOTVS RM, e de ajustes como depreciação.
model LancamentoManual {
  id               String       @id @default(uuid())
  competenciaId    String       @map("competencia_id")
  motivo           String
  filial           Int
  centroCustoId    String?      @map("centro_custo_id")
  contaResultadoId String?      @map("conta_resultado_id")
  chaveRateio      ChaveRateio? @map("chave_rateio")
  descricao        String
  linhaDREId       String       @map("linha_dre_id")
  /// DECIMAL: aritmética sempre em JavaScript.
  valor            Decimal
  criadoPor        String?      @map("criado_por")
  criadoEm         DateTime     @default(now()) @map("criado_em")
  atualizadoEm     DateTime     @updatedAt @map("atualizado_em")

  competencia    Competencia     @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  centroCusto    CentroCusto?    @relation(fields: [centroCustoId], references: [id])
  contaResultado ContaResultado? @relation(fields: [contaResultadoId], references: [id])
  linhaDRE       LinhaDRE        @relation(fields: [linhaDREId], references: [id])

  @@index([competenciaId, motivo])
  @@map("lancamentos_manuais")
}

/// Saldo de estoque por obra e linha. CONGELADO na apuração.
model EstoqueSaldo {
  id            String   @id @default(uuid())
  competenciaId String   @map("competencia_id")
  obraId        String   @map("obra_id")
  linha         String
  /// DECIMAL: volume e valor do saldo, e preço médio do período.
  saldoVolume   Decimal  @map("saldo_volume")
  saldoValor    Decimal  @map("saldo_valor")
  precoMedio    Decimal  @map("preco_medio")
  apuradoEm     DateTime @default(now()) @map("apurado_em")
  congelado     Boolean  @default(false)

  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  obra        Obra        @relation(fields: [obraId], references: [id])

  @@unique([competenciaId, obraId, linha])
  @@map("estoque_saldos")
}

// -----------------------------------------------------------------------------
// LISTAS OPERACIONAIS
//
// Treze entidades, uma por tipo, conforme decidido na entrevista. Compartilham a
// mesma forma base — competência, unidade, obra, linha, quantidade e unidade de
// medida — e cada uma acrescenta o que lhe é próprio.
//
// `importacaoId` é coluna indexada sem chave estrangeira, de propósito: é
// proveniência, usada para substituir um lote na reimportação, e criar treze
// relações inversas em `Importacao` só para isso poluiria o schema. A integridade
// que importa — competência, obra e unidade — está garantida por relação.
// -----------------------------------------------------------------------------

model Projeto {
  id               String        @id @default(uuid())
  competenciaId    String        @map("competencia_id")
  importacaoId     String?       @map("importacao_id")
  unidadeNegocioId String?       @map("unidade_negocio_id")
  obraId           String?       @map("obra_id")
  linha            String?
  quantidade       Decimal
  unidadeMedida    UnidadeMedida @default(M3) @map("unidade_medida")
  criadoPor        String?       @map("criado_por")
  criadoEm         DateTime      @default(now()) @map("criado_em")

  competencia    Competencia     @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])
  obra           Obra?           @relation(fields: [obraId], references: [id])

  @@index([competenciaId])
  @@index([importacaoId])
  @@map("projetos")
}

