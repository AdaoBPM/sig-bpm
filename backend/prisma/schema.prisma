// =============================================================================
// SIG BPM — Fechamento Mensal
//
// Banco: PostgreSQL (desde a migração de 23/10/2026; antes, SQLite em arquivo).
// Desenvolvimento: sig_bpm_dev; produção: sig_bpm (192.168.0.40). As URLs ficam
// nos .env do backend, nunca no git (ver prisma.config.ts e
// Docs/PRODUCAO-E-DESENVOLVIMENTO.md). As convenções de portabilidade de antes
// estão em prisma/PORTABILIDADE.md.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // PostgreSQL (23/10/2026). As migrações do SQLite ficam em prisma/migrations-sqlite (histórico); a inicial do
  // PostgreSQL é a prisma/migrations/0_init. Os campos Json são @db.Json (o json do PostgreSQL, que guarda o texto como
  // veio), não jsonb: o jsonb reordena as chaves dos objetos, e a Auditoria e outras telas mostram a ordem gravada.
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Usuário e auditoria (herdados do molde repositorio-padrao-bpm)
// -----------------------------------------------------------------------------

/// ENUM: o grupo de telas do menu lateral sobre o qual se concede permissão
/// (11/10/2026; antes, um recurso por área de dados). Cada grupo tem Ler e
/// Editar próprios; as regras finas das rotas derivam do grupo e dos recortes
/// do perfil (services/acesso/acesso.ts).
enum RecursoSistema {
  CENARIOS_SINTETICOS
  CENARIOS_ANALITICOS
  RESULTADOS_REALIZADOS
  FECHAMENTO_MENSAL
  CADASTROS_APURACAO
  CADASTROS_CONTROLADORIA
  CONTROLE_USUARIOS
  /// As Análises Gerenciais (15/10/2026): os Relatórios Executivos.
  ANALISES_GERENCIAIS
  /// A Central de Conectividade (24/10/2026): a Biblioteca de APIs (e as Integrações, em desenvolvimento).
  CENTRAL_CONECTIVIDADE
}

/// ENUM: ação permitida sobre um grupo — Ler (a tela aparece e os dados
/// carregam) ou Editar (pode alterar; implica Ler).
enum AcaoPermissao {
  LER
  EDITAR
}

/// Tipo de usuário. Virou cadastro, a pedido da TI, para que a empresa possa
/// criar e inativar tipos sem depender de desenvolvimento.
///
/// As permissões pertencem ao perfil, não ao usuário: quem define o que alguém
/// pode fazer é o tipo a que ele pertence.
model Perfil {
  id           String   @id @default(uuid())
  /// Código estável, usado no código e nas verificações de permissão.
  codigo       String   @unique
  nome         String
  descricao    String?
  /// Perfis de sistema não podem ser excluídos, apenas inativados — do
  /// contrário seria possível deixar a instalação sem nenhum administrador.
  sistema      Boolean  @default(false)
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  /// Recortes por dado, complementares à matriz de permissões (Passo 22):
  /// com recorteSetor, o usuário só alcança as listas operacionais dos seus
  /// setores; com recorteDepartamento, só as movimentações (lançamentos de
  /// origem) e os centros de custo dos seus departamentos. A DRE apurada é
  /// inteira para todos que têm a permissão DRE.
  recorteSetor        Boolean @default(false) @map("recorte_setor")
  recorteDepartamento Boolean @default(false) @map("recorte_departamento")
  /// Recorte por centro de custo (Coordenador, 11/10/2026): o usuário só vê os
  /// centros marcados nele (da gestão dele), e as movimentações só dentro deles.
  recorteCentro       Boolean @default(false) @map("recorte_centro")
  /// Acesso a Informações Sensíveis (27/10/2026): sem ele, o usuário não vê as movimentações das linhas de Mão de Obra
  /// Direta e Indireta (as remunerações CLT e PJ, as horas extras, as multas rescisórias, os encargos e benefícios e o
  /// pró-labore) — os extratos, os documentos e a aba Detalhes do Exportar; os valores da DRE ficam. Os perfis que já
  /// existiam ficaram com ele (o que viam continua igual).
  informacoesSensiveis Boolean @default(true) @map("informacoes_sensiveis")

  /// LISTA: o que este perfil pode fazer, por recurso e ação.
  permissoes PerfilPermissao[]
  /// A matriz por tela e por aba (14/10/2026): a que vale; a por grupo (permissoes) ficou só como histórico.
  permissoesTelas PerfilPermissaoTela[]
  usuarios   Usuario[]

  @@map("perfis")
}

/// LISTA-DE: Perfil.permissoes
///
/// A matriz de permissão: uma linha por (perfil × recurso × ação). A ausência
/// da linha é a negação — não existe permissão negativa, o que evita a pergunta
/// de qual regra vence quando duas se contradizem.
model PerfilPermissao {
  perfilId String         @map("perfil_id")
  recurso  RecursoSistema
  acao     AcaoPermissao

  perfil Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@id([perfilId, recurso, acao])
  @@index([recurso, acao])
  @@map("perfil_permissoes")
}

/// A permissão de um perfil numa tela ou numa aba (14/10/2026): a chave é o código da tela (a área das rotas) ou
/// "tela.aba", do catálogo services/acesso/telas.ts. Editar implica Ler (as duas linhas ficam gravadas).
model PerfilPermissaoTela {
  perfilId String        @map("perfil_id")
  chave    String
  acao     AcaoPermissao

  perfil Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@id([perfilId, chave, acao])
  @@map("perfil_permissoes_telas")
}

model Usuario {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash    String   @map("senha_hash")
  perfilId     String   @map("perfil_id")
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  perfil Perfil @relation(fields: [perfilId], references: [id])

  /// LISTA: quais listas operacionais este usuário pode preencher.
  /// Recorte por dado, complementar ao recorte por recurso que o perfil dá.
  setores UsuarioSetor[]
  /// LISTA: departamentos cujas movimentações o usuário pode consultar, quando
  /// o perfil tem recorte por departamento.
  departamentos UsuarioDepartamento[]
  /// A gestão (departamento) sob a qual o usuário está, quando o perfil tem
  /// recorte por centro de custo: os centros dele são dessa gestão.
  gestao        DepartamentoAcesso?
  /// LISTA: os centros de custo que o usuário alcança, quando o perfil tem
  /// recorte por centro de custo.
  centros       UsuarioCentro[]
  /// Com recorte por centro de custo: o usuário vê também os resultados das
  /// obras, nas linhas da DRE da gestão dele (e nas abertas a todos).
  veObras       Boolean @default(false) @map("ve_obras")

  competenciasAbertas   Competencia[] @relation("CompetenciaAberta")
  competenciasApuradas  Competencia[] @relation("CompetenciaApurada")
  competenciasFechadas  Competencia[] @relation("CompetenciaFechada")
  reaberturas           ReaberturaCompetencia[]
  importacoes           Importacao[]
  conferenciasPlanilha  ConferenciaPlanilha[]

  @@map("usuarios")
}

/// LISTA-DE: Usuario.setores
///
/// Quais tipos de lista o Alimentador pode preencher. Reaproveita
/// `TipoImportacao` porque o recorte de permissão é exatamente por tipo de lista.
/// Os sete departamentos do recorte do Gestor (decisão do usuário, 30/09/2026).
enum DepartamentoAcesso {
  PRODUCAO
  SERVICOS
  LOGISTICA
  TECNICO
  COMERCIAL
  ADMINISTRATIVO
  EXTRA_OPERACIONAL
}

model UsuarioCentro {
  usuarioId     String @map("usuario_id")
  centroCustoId String @map("centro_custo_id")

  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  centroCusto CentroCusto @relation(fields: [centroCustoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, centroCustoId])
  @@map("usuario_centros")
}

model UsuarioDepartamento {
  usuarioId    String             @map("usuario_id")
  departamento DepartamentoAcesso

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, departamento])
  @@map("usuario_departamentos")
}

model UsuarioSetor {
  usuarioId String         @map("usuario_id")
  tipoLista TipoImportacao @map("tipo_lista")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, tipoLista])
  @@index([tipoLista])
  @@map("usuario_setores")
}

/// Log de auditoria (LogAuditoria do SPEC, Passo 23): imutável — gatilhos no
/// banco recusam UPDATE e DELETE (migração 20260930140000_auditoria_imutavel).
model AuditLog {
  id          String   @id @default(uuid())
  acao        String
  entidade    String?
  entidadeId  String?  @map("entidade_id")
  usuarioId   String?  @map("usuario_id")
  usuarioNome String?  @map("usuario_nome")
  ip          String?
  userAgent   String?  @map("user_agent")
  /// JSON: suportado nos dois bancos. Em SQLite o Prisma serializa e valida.
  dadosAntes  Json? @db.Json @map("dados_antes")
  dadosDepois Json? @db.Json @map("dados_depois")
  metadados   Json? @db.Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([usuarioId, createdAt(sort: Desc)])
  @@index([entidade, entidadeId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
}

// =============================================================================
// CADASTROS DE PARAMETRIZAÇÃO (Passo 2)
//
// São os dados que o Contábil mantém e que governam a classificação e o rateio.
// Correspondem hoje às abas `Centros de Custo`, `Contas de Resultado`,
// `Tipos de Movimento`, `Tabela de Estacas` e à estrutura do
// `Realizado (Consolidado)` do arquivo UNIDADES E CENTROS DE CUSTO.
//
// REGRA GERAL DOS CADASTROS
// Todo cadastro tem `id` (chave interna) e `ordem` (posição na tela, que o
// usuário reorganiza subindo e descendo itens). A `ordem` é apresentação e muda
// a qualquer momento — por isso NÃO é única e NENHUMA regra de negócio se apoia
// nela. Referência entre registros usa `id` ou um `codigo` estável.
// =============================================================================

/// ENUM: nível da conta no plano de contas do ERP. Só ANALITICA classifica.
enum TipoConta {
  SINTETICA
  ANALITICA
}

/// ENUM: papel da linha na estrutura da DRE.
/// SECAO é só rótulo e não carrega valor; ITEM soma lançamentos;
/// SUBTOTAL e TOTAL são calculados pela `expressao`.
enum TipoLinhaDRE {
  SECAO
  ITEM
  SUBTOTAL
  TOTAL
}

/// ENUM: se o custo do centro de custo é direto ou indireto.
/// Vem da coluna ATRIBUIÇÃO da aba `Centros de Custo`.
enum AtribuicaoCusto {
  DIRETA
  INDIRETA
}

/// ENUM: balde de alocação. Corresponde à coluna RATEIO das abas
/// `Centros de Custo` e `Contas de Resultado`, que apesar do nome carrega dois
/// papéis distintos:
///
/// - os cinco primeiros são CHAVES DE RATEIO: o valor é distribuído entre
///   unidades conforme o volume físico da competência;
/// - os demais são BALDES DIRETOS: o valor vai inteiro para um destino, e é o
///   que separa as abas da DRE (Serviços filtra OBRAS e COMPLEMENTAR,
///   Desp.+Extra filtra DESPESAS, RN filtra RN).
///
/// `TipoAlocacao` (DIRETO ou RATEIO) é derivado da pertinência ao primeiro
/// grupo, como a coluna ALOCAÇÃO da planilha já faz.
enum BaldeAlocacao {
  // --- chaves de rateio ---
  PROJETO
  PRODUCAO
  METALURGIA
  ARMADURA
  ACOMPANHAMENTO
  // --- baldes diretos ---
  UNIDADE
  MATRIZ
  FILIAL
  OBRAS
  COMPLEMENTAR
  DESPESAS
  EXTRA
  RN
  /// Construtora do mesmo grupo, com atividades encerradas. As contas de
  /// operação marcadas com este balde estão em desuso; restam movimentações
  /// financeiras. Mantido no cadastro para não perder o histórico.
  LEBEN
}

/// ENUM: grandeza física que serve de direcionador do rateio.
/// Destino de uma parcela de rateio.
enum DestinoRateio {
  MATRIZ
  FILIAL
  MONTAGEM
  COMPLEMENTAR
}

enum BaseFisica {
  M3
  KG
  PISTA
  DIA
}

/// ENUM: a que domínio a linha pertence.
/// A planilha chama as três de "linha", mas são vocabulários distintos:
/// PRODUTO classifica a peça produzida, OBRA a etapa do serviço, e FATURAMENTO
/// a natureza do que se fatura na obra.
enum TipoLinha {
  PRODUTO
  OBRA
  FATURAMENTO
}

/// Linhas de produto, de obra e de faturamento — hoje mantidas na aba `Listas`
/// do LISTAS REALIZADO (OPERAÇÃO), promovidas a cadastro.
///
/// Um só cadastro com discriminador `tipo`, em vez de três tabelas: é uma tela
/// só com filtro, e acrescentar um domínio novo não exige tabela nova. A
/// contrapartida é que a coerência entre o tipo da linha e o registro que a
/// referencia (uma produção deve usar linha de PRODUTO) é validada na aplicação.
model Linha {
  id           String    @id @default(uuid())
  tipo         TipoLinha
  codigo       String
  nome         String
  /// A unidade da linha (cadastro Linhas, 10/10/2026): Matriz e Filial para os produtos, Serviços para as linhas de
  /// obra. As linhas de faturamento (das medições) não têm unidade.
  unidadeNegocioId String? @map("unidade_negocio_id")
  unidadeNegocio   UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id], onDelete: SetNull)
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem        Int       @default(0)
  ativo        Boolean   @default(true)
  /// A unidade de medida da linha (12/10/2026): m³, m³ e pistas, kg, m, m², dia ou %. Para os Cenários Analíticos.
  unidadeMedida String?  @map("unidade_medida")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  obras             Obra[]
  precosContrato    PrecoContrato[]
  estoqueSaldos     EstoqueSaldo[]
  estoqueIniciais   EstoqueSaldoInicial[]
  projetos          Projeto[]
  producoes         Producao[]
  producoesPista    ProducaoPista[]
  producoesArmadura ProducaoArmadura[]
  producoesMetalurgia ProducaoMetalurgia[]
  expedicoes        Expedicao[]
  montagens         Montagem[]
  acompanhamentos   Acompanhamento[]
  medicoes          Medicao[]
  devolucoes        Devolucao[]
  saidas            Saida[]
  correspondenciasTarefas CorrespondenciaTarefa[]
  alocacoes               AlocacaoLinha[]
  resultados              ResultadoLinha[]
  rateiosFixos            RegraRateioLinha[]

  @@unique([tipo, codigo])
  @@index([tipo, ordem])
  @@map("linhas")
}

model UnidadeNegocio {
  id        String      @id @default(uuid())
  codigo    Int         @unique
  /// O nome identifica a unidade onde a planilha a cita (as abas Realizado (…) da carga da Estrutura da DRE);
  /// a regra de apuração vem do código. O tipo saiu em 09/10/2026.
  nome      String
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem     Int         @default(0)
  ativo     Boolean     @default(true)
  criadoEm  DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  centrosCusto   CentroCusto[]
  regrasRateio   RegraRateio[]
  /// LISTA: as linhas da unidade (cadastro Linhas).
  linhas         Linha[]
  /// LISTA: linhas da DRE que se aplicam a esta unidade.
  linhasDRE      LinhaDREUnidade[]
  obras          Obra[]

  projetos            Projeto[]
  producoes           Producao[]
  producoesPista      ProducaoPista[]
  producoesArmadura   ProducaoArmadura[]
  producoesMetalurgia ProducaoMetalurgia[]
  expedicoes          Expedicao[]
  montagens           Montagem[]
  acompanhamentos     Acompanhamento[]
  medicoes            Medicao[]
  devolucoes          Devolucao[]
  saidas              Saida[]

  receitasPrevias     ReceitaPrevia[]
  lancamentosReceita  LancamentoReceita[]
  volumesOperacionais VolumeOperacional[]
  resultadosApurados  ResultadoApurado[]

  @@map("unidades_negocio")
}

model CentroCusto {
  id                String          @id @default(uuid())
  coligada          Int?
  /// Chave de conciliação com o TOTVS RM. Opcional: há centros mantidos só
  /// pela controladoria, sem correspondente no ERP.
  codigoRM          String?         @unique @map("codigo_rm")
  nomeRM            String          @map("nome_rm")
  /// Nome adotado pela controladoria; agrupa vários centros sob um mesmo rótulo.
  nomeControladoria String?         @map("nome_controladoria")
  departamento      String?
  departamentoSigla String?          @map("departamento_sigla")
  atribuicao        AtribuicaoCusto?
  atribuicaoSigla   String?          @map("atribuicao_sigla")
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem             Int             @default(0)
  ativo             Boolean         @default(true)
  criadoEm          DateTime        @default(now()) @map("criado_em")
  atualizadoEm      DateTime        @updatedAt @map("atualizado_em")

  balde      BaldeAlocacao? @map("balde")
  unidadeNegocioId String?      @map("unidade_negocio_id")

  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])

  lancamentosContabeis LancamentoContabil[]
  lancamentosManuais   LancamentoManual[]
  resultadosApurados   ResultadoApurado[]
  usuarios             UsuarioCentro[]
  alocacoesLinhas      AlocacaoLinha[]

  @@index([nomeControladoria])
  @@index([balde])
  @@map("centros_custo")
}

model ContaResultado {
  id             String         @id @default(uuid())
  /// Código reduzido, chave de conciliação do balancete.
  /// É TEXTO, não número: além dos códigos do ERP, carrega as contas
  /// gerenciais criadas fora dele — 22 contas `RN.*`, que só passam a existir
  /// no TOTVS RM a partir de janeiro, e 18 contas com sufixo `.D`.
  reduzido       String         @unique
  /// Código hierárquico, ex.: 3.02.01.03.01.01
  conta          String
  descricao      String
  tipoConta      TipoConta      @map("tipo_conta")
  departamento   String?
  /// Subgrupo na DRE, ex.: "Receita Bruta de Montagem". Não confundir com a
  /// ATRIBUIÇÃO do centro de custo, que é direta/indireta — ver PORTABILIDADE.md.
  atribuicao     String?
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem          Int            @default(0)
  ativo          Boolean        @default(true)
  criadoEm       DateTime       @default(now()) @map("criado_em")
  atualizadoEm   DateTime       @updatedAt @map("atualizado_em")

  balde BaldeAlocacao? @map("balde")
  linhaDREId  String?      @map("linha_dre_id")

  linhaDRE LinhaDRE? @relation(fields: [linhaDREId], references: [id])

  lancamentosContabeis LancamentoContabil[]
  lancamentosAdotados  LancamentoContabil[] @relation("ContaAdotada")
  lancamentosManuais   LancamentoManual[]
  reclassificacoesOrigem  ReclassificacaoConta[] @relation("ReclassificacaoOrigem")
  reclassificacoesDestino ReclassificacaoConta[] @relation("ReclassificacaoDestino")

  @@index([conta])
  @@index([linhaDREId])
  @@map("contas_resultado")
}

/// A estrutura da DRE é dado, não código (RF003 do SPEC).
model LinhaDRE {
  id              String       @id @default(uuid())
  /// Código estável e legível da linha, ex.: "ROL", "CPV", "CPP.MOD.CLT".
  /// É por ele que as expressões de subtotal referenciam outras linhas —
  /// nunca pela `ordem`, que o usuário reorganiza na tela.
  codigo          String       @unique
  /// ORDEM: posição na DRE, reorganizável pelo usuário. Apresentação apenas.
  ordem           Int          @default(0)
  grupo           String
  grupoSigla      String       @map("grupo_sigla")
  atribuicao      String?
  atribuicaoSigla String?      @map("atribuicao_sigla")
  descricao       String
  tipo            TipoLinhaDRE
  /// Fórmula do subtotal, referenciando outras linhas pelo `codigo`,
  /// ex.: "ROL - CPV". Nulo quando `tipo` é ITEM.
  expressao       String?
  /// O que a linha significa — vem da coluna de definição da planilha.
  definicao       String?
  ativo           Boolean      @default(true)
  criadoEm        DateTime     @default(now()) @map("criado_em")
  atualizadoEm    DateTime     @updatedAt @map("atualizado_em")

  contas    ContaResultado[]
  /// LISTA: em quais unidades esta linha aparece.
  unidades  LinhaDREUnidade[]

  lancamentosContabeis LancamentoContabil[]
  lancamentosManuais   LancamentoManual[]
  resultadosApurados   ResultadoApurado[]
  resultadosLinhas     ResultadoLinha[]
  cenariosResultados   CenarioResultado[]
  cenariosJustificativas CenarioJustificativa[]

  @@index([grupoSigla])
  @@map("linhas_dre")
  cenariosCentros CenarioCentro[]
}

/// LISTA-DE: LinhaDRE.unidadesAplicaveis (seria `String[]` no PostgreSQL)
///
/// Convertida em tabela de relação por duas razões: o SQLite não suporta lista
/// escalar, e aqui a lista é de referências a UnidadeNegocio — então a relação
/// dá integridade referencial que um array de texto não daria.
model LinhaDREUnidade {
  linhaDREId       String @map("linha_dre_id")
  unidadeNegocioId String @map("unidade_negocio_id")

  linhaDRE       LinhaDRE       @relation(fields: [linhaDREId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio @relation(fields: [unidadeNegocioId], references: [id], onDelete: Cascade)

  @@id([linhaDREId, unidadeNegocioId])
  @@index([unidadeNegocioId])
  @@map("linhas_dre_unidades")
}

/// Direcionador de rateio. O percentual NÃO é cadastrado — é calculado por
/// competência a partir do volume físico realizado (RF007 do SPEC).
model RegraRateio {
  id               String      @id @default(uuid())
  /// Só os cinco valores de rateio de `BaldeAlocacao` são válidos aqui;
  /// a restrição é aplicada na aplicação, já que o enum é um só.
  chave            BaldeAlocacao
  /// Destino nominal da parcela. Montagem e Complementar são as duas visões
  /// de Serviços, por isso a unidade sozinha não identifica o destino.
  destino          DestinoRateio
  /// Unidade de negócio que recebe o custo (Serviços para Montagem e Complementar).
  unidadeDestinoId String      @map("unidade_destino_id")
  /// Rótulo da linha na aba Rateios, ex.: "(P) Metalurgia: Montagem".
  rotulo           String
  baseFisica       BaseFisica  @map("base_fisica")
  /// Linha dos Totais que fornece o volume, pelo código (ex.: METALURGIA_MONTAGEM):
  /// o vínculo é nominal, não pela posição na planilha.
  origemDoVolume   String      @map("origem_do_volume")
  vigenciaInicio   DateTime    @map("vigencia_inicio")
  vigenciaFim      DateTime?   @map("vigencia_fim")
  /// O percentual fixo do destino (14/10/2026; 0 a 1): preenchido, substitui o percentual dos volumes. As regras fixas de
  /// uma chave e de um período somam 100% (a tela Percentuais Fixos grava todas juntas); o volume continua apurado.
  percentualFixo   Decimal?    @map("percentual_fixo")
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem            Int         @default(0)
  criadoEm         DateTime    @default(now()) @map("criado_em")
  atualizadoEm     DateTime    @updatedAt @map("atualizado_em")

  unidadeDestino UnidadeNegocio @relation(fields: [unidadeDestinoId], references: [id])

  volumesOperacionais VolumeOperacional[]
  linhas              RegraRateioLinha[]

  @@unique([chave, destino, vigenciaInicio])
  @@index([chave])
  @@map("regras_rateio")
}

/// Os percentuais por linha de uma regra de percentual fixo (26/10/2026): como a parte do destino se divide entre as
/// linhas da unidade dele, somando 100% no destino (a tela Percentuais Fixos grava junto com a regra). A etapa Linhas da
/// apuração usa estes percentuais na parte de rateio da chave, no lugar da regra da Alocação nas Linhas.
model RegraRateioLinha {
  id            String  @id @default(uuid())
  regraRateioId String  @map("regra_rateio_id")
  linhaId       String  @map("linha_id")
  /// DECIMAL: a fração da parte do destino que vai à linha (0 a 1).
  percentual    Decimal

  regraRateio RegraRateio @relation(fields: [regraRateioId], references: [id], onDelete: Cascade)
  linha       Linha       @relation(fields: [linhaId], references: [id], onDelete: Restrict)

  @@unique([regraRateioId, linhaId])
  @@index([linhaId])
  @@map("regras_rateio_linhas")
}

model TipoMovimento {
  id             String   @id @default(uuid())
  /// Código do movimento no ERP, ex.: 1.2.18
  codigo         String   @unique
  descricao      String
  retornaEstoque Boolean  @map("retorna_estoque")
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem          Int      @default(0)
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  devolucoes   Devolucao[]
  saidas       Saida[]

  @@map("tipos_movimento")
}

model TabelaEstaca {
  id             String    @id @default(uuid())
  secao          String
  grupo          String
  /// Código da peça: grupo + os dois primeiros dígitos da seção (ex.: ES26).
  peca           String
  /// DECIMAL: aritmética sempre em JavaScript, nunca em SQL cru.
  /// Ver a ressalva de precisão do SQLite em PORTABILIDADE.md.
  precoUnitario  Decimal   @map("preco_unitario")
  /// DECIMAL: RL PROD. (R$/m³), a receita líquida de produção por m³.
  precoLiquido   Decimal   @map("preco_liquido")
  vigenciaInicio DateTime  @map("vigencia_inicio")
  vigenciaFim    DateTime? @map("vigencia_fim")
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem          Int       @default(0)
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  @@unique([secao, grupo, vigenciaInicio])
  @@map("tabela_estacas")
}

// =============================================================================
// GOVERNANÇA DA APURAÇÃO (Passo 3)
//
// Competência, importação, divergência e auditoria. É aqui que mora o
// Princípio de Congelamento da Apuração descrito no SPEC.md: apurar grava o
// retrato do mês e o congela; só a reabertura permite nova apuração.
// =============================================================================

/// ENUM: estado da competência.
/// ABERTA → EM_CONFERENCIA → FECHADA, e FECHADA → ABERTA por reabertura.
enum StatusCompetencia {
  ABERTA
  EM_CONFERENCIA
  FECHADA
}

/// ENUM: tipo de arquivo ou lista que entra no sistema.
/// Serve tanto para `Importacao.tipo` quanto para dizer quais listas um
/// Alimentador pode preencher (`UsuarioSetor.tipoLista`).
enum TipoImportacao {
  BALANCETE
  DRE_COMERCIAL
  ESTOQUE_INICIAL
  PROJETO
  PRODUCAO
  PRODUCAO_PISTA
  PRODUCAO_ARMADURA
  PRODUCAO_METALURGIA
  EXPEDICAO
  MONTAGEM
  ACOMPANHAMENTO
  MEDICAO
  DEVOLUCAO
  SAIDA
  /// Indicadores gerenciais do mês: aba Indicadores (Admin.) do LISTAS REALIZADO (OPERAÇÃO).
  INDICADORES_ADMIN
  /// Indicadores gerenciais do mês: aba Indicadores (Comercial) do CONTROLE DAS VENDAS - COMERCIAL.
  INDICADORES_COMERCIAL
  /// Metas do orçamento do mês: aba Metas (Orçamento) do INDICADORES DE RESULTADO.
  METAS_ORCAMENTO
  /// Os itens das requisições do mês: aba Requisições (Lista) do LISTAS REALIZADO (RESULTADOS) (11/10/2026).
  REQUISICOES
  /// Os itens das notas fiscais do mês: aba Notas Fiscais (Lista) do LISTAS REALIZADO (RESULTADOS) (11/10/2026).
  NOTAS_FISCAIS
  /// Os colaboradores do mês por centro de custo: aba Quadro de Lotação do LISTAS REALIZADO (OPERAÇÃO) (19/10/2026).
  QUADRO_LOTACAO
}

/// ENUM: estado do processamento de uma importação.
enum StatusImportacao {
  PROCESSANDO
  CONCLUIDA
  REJEITADA
}

/// ENUM: o que originou a divergência retroativa (RF010 do SPEC).
enum TipoDivergencia {
  BALANCETE
  PRECO_CONTRATO
}

/// ENUM: tratamento dado à divergência.
enum StatusDivergencia {
  ABERTA
  JUSTIFICADA
  RESOLVIDA_POR_REABERTURA
  /// A competência, ainda aberta, foi reapurada com o preço novo (Passo 24).
  RESOLVIDA_POR_REAPURACAO
}

model Competencia {
  id     String            @id @default(uuid())
  ano    Int
  mes    Int
  status StatusCompetencia @default(ABERTA)

  abertaEm   DateTime @default(now()) @map("aberta_em")
  abertaPor  String   @map("aberta_por")
  /// Última apuração. Nulo enquanto o mês não foi apurado.
  apuradaEm  DateTime? @map("apurada_em")
  apuradaPor String?   @map("apurada_por")
  /// Quantas vezes o mês foi apurado — reapurar é normal durante a conferência.
  apuracoes  Int       @default(0) @map("apuracoes")
  fechadaEm  DateTime? @map("fechada_em")
  fechadaPor String?   @map("fechada_por")
  /// JSON: retrato das entradas no momento da apuração (contagens e somas dos
  /// lançamentos, das listas e das importações ativas). Comparado com as
  /// entradas atuais, diz se algo mudou depois da apuração (Passo 21).
  entradasApuradas Json? @db.Json @map("entradas_apuradas")
  /// JSON: a assinatura de cada cadastro da Controladoria na apuração (17/10/2026; antes, só a do Painel de Bordo): se
  /// algum muda com a competência apurada e ainda aberta, a situação pede reapurar (e o fechamento fica bloqueado até lá).
  cadastrosAssinatura String? @map("cadastros_assinatura")
  /// JSON: a etapa Linhas da apuração (26/10/2026): quando gravou, de que passo da Alocação nas Linhas veio cada valor
  /// (por unidade), os documentos do mês e os avisos. Nulo: as linhas do mês não foram gravadas (os valores ficam em
  /// ResultadoLinha).
  apuracaoLinhas Json? @db.Json @map("apuracao_linhas")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  usuarioAbertura  Usuario  @relation("CompetenciaAberta", fields: [abertaPor], references: [id])
  usuarioApuracao  Usuario? @relation("CompetenciaApurada", fields: [apuradaPor], references: [id])
  usuarioFechamento Usuario? @relation("CompetenciaFechada", fields: [fechadaPor], references: [id])

  /// LISTA: histórico de reaberturas, uma por ocorrência.
  historicoReaberturas ReaberturaCompetencia[]
  importacoes          Importacao[]
  divergencias         Divergencia[]

  lancamentosContabeis LancamentoContabil[]
  lancamentosManuais   LancamentoManual[]
  estoqueSaldos        EstoqueSaldo[]
  estoqueIniciais      EstoqueSaldoInicial[]
  indicadoresImportados IndicadorImportado[]
  metasImportadas       MetaImportada[]
  requisicoes           RequisicaoItem[]
  notasFiscais          NotaFiscalItem[]
  indicadoresDigitados  IndicadorDigitado[]
  lotacoes              LotacaoCentro[]

  projetos            Projeto[]
  producoes           Producao[]
  producoesPista      ProducaoPista[]
  producoesArmadura   ProducaoArmadura[]
  producoesMetalurgia ProducaoMetalurgia[]
  expedicoes          Expedicao[]
  montagens           Montagem[]
  acompanhamentos     Acompanhamento[]
  medicoes            Medicao[]
  devolucoes          Devolucao[]
  saidas              Saida[]

  receitasPrevias     ReceitaPrevia[]
  lancamentosReceita  LancamentoReceita[]
  volumesOperacionais VolumeOperacional[]
  resultadosApurados  ResultadoApurado[]
  resultadosLinhas    ResultadoLinha[]
  conferenciasPlanilha ConferenciaPlanilha[]

  @@unique([ano, mes])
  @@index([status])
  @@map("competencias")
}

/// Cada reabertura é um registro próprio, com justificativa e autor.
/// Guardar o histórico completo é o que permite auditar um mês reapurado
/// várias vezes — um contador só diria quantas, não por quê.
model ReaberturaCompetencia {
  id            String   @id @default(uuid())
  competenciaId String   @map("competencia_id")
  justificativa String
  reabertaEm    DateTime @default(now()) @map("reaberta_em")
  reabertaPor   String   @map("reaberta_por")
  /// O fechamento que a reabertura desfez.
  fechamentoAnteriorEm  DateTime? @map("fechamento_anterior_em")
  fechamentoAnteriorPor String?   @map("fechamento_anterior_por")

  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  usuario     Usuario     @relation(fields: [reabertaPor], references: [id])

  @@index([competenciaId, reabertaEm])
  @@map("reaberturas_competencia")
}

model Importacao {
  id              String           @id @default(uuid())
  /// Balancete recebido para competência fechada (Passo 24): só é comparado com
  /// o gravado, e as diferenças viram divergências — nada é substituído.
  comparacao      Boolean          @default(false)
  /// Importação em lote: a competência (aaaa-mm) em que o arquivo foi enviado,
  /// quando o lote importou os dados do mês desta outra competência (um mês
  /// anterior ainda aberto, com dados diferentes no arquivo). Sinaliza a
  /// competência (bola verde) até a próxima apuração.
  enviadaDe       String?          @map("enviada_de")
  competenciaId   String           @map("competencia_id")
  tipo            TipoImportacao
  nomeArquivo     String           @map("nome_arquivo")
  /// Impressão digital do conteúdo — impede reprocessar o mesmo arquivo por engano.
  hashArquivo     String           @map("hash_arquivo")
  importadoPor    String           @map("importado_por")
  importadoEm     DateTime         @default(now()) @map("importado_em")
  linhasLidas     Int              @default(0) @map("linhas_lidas")
  linhasAceitas   Int              @default(0) @map("linhas_aceitas")
  linhasRejeitadas Int             @default(0) @map("linhas_rejeitadas")
  /// Linhas do arquivo que não são lançamento: subtotais da tabela dinâmica e
  /// linhas sem movimentação no mês. Lidas = aceitas + rejeitadas + ignoradas.
  linhasIgnoradas Int              @default(0) @map("linhas_ignoradas")
  status          StatusImportacao @default(PROCESSANDO)
  /// Percentual processado, de 0 a 100, para a tela acompanhar.
  progresso       Int              @default(0)
  /// Motivo quando o arquivo inteiro é recusado — leiaute, mês ausente,
  /// total que não confere. Nesse caso nenhuma linha é gravada.
  motivoRejeicao  String?          @map("motivo_rejeicao")
  /// JSON: erros por linha, para o relatório de importação.
  relatorioErros  Json? @db.Json @map("relatorio_erros")
  /// JSON: totais conferidos e avisos que não impedem a gravação.
  resumo          Json? @db.Json
  /// Uma reimportação do mesmo tipo na mesma competência substitui a anterior,
  /// que fica marcada aqui em vez de ser apagada.
  substituidaEm   DateTime?        @map("substituida_em")

  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  usuario     Usuario     @relation(fields: [importadoPor], references: [id])

  divergencias         Divergencia[]
  lancamentosContabeis LancamentoContabil[]

  estoqueIniciais EstoqueSaldoInicial[]
  indicadores     IndicadorImportado[]
  metas           MetaImportada[]
  requisicoes     RequisicaoItem[]
  notasFiscais    NotaFiscalItem[]
  lotacoes        LotacaoCentro[]

  @@index([competenciaId, tipo])
  @@index([hashArquivo])
  @@map("importacoes")
}

/// Divergência retroativa: dado novo que conflita com o que já foi apurado ou
/// fechado. Registrar NUNCA altera a competência (RF010 do SPEC).
model Divergencia {
  id            String            @id @default(uuid())
  competenciaId String            @map("competencia_id")
  tipo          TipoDivergencia
  importacaoId  String            @map("importacao_id")

  /// Preenchidos quando `tipo` é BALANCETE: a chave da comparação é filial +
  /// centro de custo + conta, como vêm no arquivo (o centro e a conta podem
  /// não estar no cadastro — obras, contas novas).
  contaResultadoId String? @map("conta_resultado_id")
  centroCustoId    String? @map("centro_custo_id")
  filial            Int?
  codigoCentroCusto String? @map("codigo_centro_custo")
  codigoConta       String? @map("codigo_conta")
  /// Preenchido quando `tipo` é PRECO_CONTRATO: o preço que valorou a receita
  /// apurada e foi substituído na reimportação da DRE do Comercial.
  precoContratoId   String? @map("preco_contrato_id")
  /// O que é a diferença, em texto: conta e centro, ou obra, linha e conta da DRE de venda.
  descricao         String?
  /// DECIMAL: no preço, o efeito na receita apurada (quantidade × diferença do preço).
  impacto           Decimal?
  /// Preenchido quando `tipo` é PRECO_CONTRATO.
  /// A relação com Obra é criada no Passo 4, quando o modelo existir.
  obraId           String? @map("obra_id")

  /// DECIMAL: aritmética sempre em JavaScript. Ver PORTABILIDADE.md.
  valorGravado  Decimal           @map("valor_gravado")
  valorRecebido Decimal           @map("valor_recebido")
  diferenca     Decimal
  detectadaEm   DateTime          @default(now()) @map("detectada_em")
  status        StatusDivergencia @default(ABERTA)
  justificativa String?
  tratadaEm     DateTime?         @map("tratada_em")
  tratadaPor    String?           @map("tratada_por")

  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  importacao  Importacao  @relation(fields: [importacaoId], references: [id])
  obra        Obra?       @relation(fields: [obraId], references: [id])

  @@index([competenciaId, status])
  @@index([status])
  @@map("divergencias")
}

// =============================================================================
// MOVIMENTO (Passo 4)
//
// O que entra por importação ou digitação em cada competência: obras, preços
// de contrato, lançamentos contábeis e manuais, as listas operacionais e o
// saldo de estoque.
// =============================================================================

/// ENUM: modalidade de venda da obra.
enum TipoVenda {
  GLOBAL
  MERCANTIL
}

/// ENUM: situação do cadastro da obra, apurada na importação.
/// GENERICA são os estoques de acabados sem projeto vendido (G11, M2, M3, M9999),
/// precificados por tabela. SEM_CONTRATO e INCONSISTENTE são pendências a reportar.
enum SituacaoCadastroObra {
  OK
  SEM_CONTRATO
  GENERICA
  INCONSISTENTE
}

/// ENUM: se o lançamento vai direto para uma unidade ou é rateado.
enum TipoAlocacao {
  DIRETO
  RATEIO
}

/// ENUM: resultado da checagem de classificação do lançamento (RF006 do SPEC).
/// Qualquer valor diferente de OK impede o fechamento da competência.
enum ValidacaoLancamento {
  OK
  /// <ERRO!> da planilha: o centro tem departamento ou atribuição e a conta não.
  ERRO_PARAMETRIZACAO
  /// <DEP.!>: departamento do centro diferente do departamento da conta.
  ERRO_DEPARTAMENTO
  /// <ATR.!>: atribuição do centro incompatível com a da conta.
  ERRO_ATRIBUICAO
  /// Conta analítica sem linha na DRE.
  SEM_DESTINO
  /// Código de centro de custo que não está no cadastro (fora os de obra).
  CENTRO_NAO_CADASTRADO
  /// A linha da DRE da conta e o balde do centro não se combinam em nenhuma aba de resultado (21/10/2026): o valor
  /// ficaria fora do resultado (ex.: conta de Montagem com centro de balde COMPLEMENTAR, sem a linha equivalente nos
  /// Complementares).
  SEM_ABA
}

/// ENUM: unidade de medida das listas operacionais.
enum UnidadeMedida {
  M3
  M2
  M
  KG
  PISTA
  DIA
  UND
}

model Obra {
  id               String               @id @default(uuid())
  codigo           String               @unique
  nome             String
  unidadeNegocioId String?              @map("unidade_negocio_id")
  linhaId            String? @map("linha_id")
  linha            Linha?  @relation(fields: [linhaId], references: [id])
  tipoVenda        TipoVenda?           @map("tipo_venda")
  /// Estoque de acabados sem projeto vendido — precificado por tabela.
  generica         Boolean              @default(false)
  situacaoCadastro SituacaoCadastroObra @default(OK) @map("situacao_cadastro")
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem            Int                  @default(0)
  criadoEm         DateTime             @default(now()) @map("criado_em")
  atualizadoEm     DateTime             @updatedAt @map("atualizado_em")

  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])

  precos        PrecoContrato[]
  estoques      EstoqueSaldo[]
  estoqueIniciais EstoqueSaldoInicial[]
  divergencias  Divergencia[]

  projetos            Projeto[]
  producoes           Producao[]
  producoesPista      ProducaoPista[]
  producoesArmadura   ProducaoArmadura[]
  producoesMetalurgia ProducaoMetalurgia[]
  expedicoes          Expedicao[]
  montagens           Montagem[]
  acompanhamentos     Acompanhamento[]
  medicoes            Medicao[]
  devolucoes          Devolucao[]
  saidas              Saida[]

  @@index([situacaoCadastro])
  @@map("obras")
}

/// Preço de contrato vindo da aba `DRE` do CONTROLE DAS VENDAS.
/// HISTORIADO, não sobrescrito: uma reimportação marca o anterior como
/// substituído e cria o novo, para que a receita de competências já apuradas
/// continue explicável. Ver o Princípio de Congelamento no SPEC.md.
model PrecoContrato {
  id             String   @id @default(uuid())
  obraId         String   @map("obra_id")
  /// VERSÃO (N) da DRE do Comercial: 0 é o contrato original (VER00), os
  /// demais são aditivos — guardados, mas fora da apuração na V1.
  versao         Int
  /// Chave do preço no histórico: obra | versão | etapa | linha | conta | departamento.
  /// Uma reimportação compara pela chave: igual fica, diferente substitui.
  chave          String
  etapa          String?
  /// LINHA como vem na DRE; linhaId quando ela existe no cadastro de linhas
  /// (METALÚRGICA, por exemplo, não existe).
  linhaTexto     String   @map("linha_texto")
  linhaId        String?  @map("linha_id")
  linha          Linha?   @relation(fields: [linhaId], references: [id])
  /// CONTA CONTÁBIL da DRE de venda, ex.: "Receita Bruta do Pré-Fabricado".
  contaResultado String   @map("conta_resultado")
  /// DEPTO. e ATRIBUIÇÃO da DRE de venda. A receita prévia procura o preço pela
  /// atribuição ("Receita Bruta do Pré-Fabricado", "Receita Bruta de Frete"…).
  departamento   String?
  atribuicao     String?
  /// UNIDADE e FORNECIMENTO da DRE de venda (MATRIZ, FILIAL, OBRAS; Obra, Lajes, Estacas).
  unidade        String?
  fornecimento   String?
  /// DECIMAL: aritmética sempre em JavaScript. Ver PORTABILIDADE.md.
  /// Nulos quando a DRE traz "-" ou vazio.
  valorUnitario  Decimal? @map("valor_unitario")
  valorTotal     Decimal? @map("valor_total")
  percentualRL   Decimal? @map("percentual_rl")
  importacaoId   String?  @map("importacao_id")
  vigenteDesde   DateTime @default(now()) @map("vigente_desde")
  substituidoEm  DateTime? @map("substituido_em")

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  receitasPrevias ReceitaPreviaPreco[]

  @@index([obraId, versao])
  @@index([chave, substituidoEm])
  @@index([substituidoEm])
  @@map("precos_contrato")
}

/// Lançamento do balancete. É IMUTÁVEL — divergência de classificação se
/// corrige no cadastro e se reflete aqui na próxima apuração.
/// O valor gravado é a MOVIMENTAÇÃO DO MÊS, não o saldo da conta.
model LancamentoContabil {
  id            String @id @default(uuid())
  competenciaId String @map("competencia_id")
  importacaoId  String @map("importacao_id")
  filial        Int
  centroCustoId String? @map("centro_custo_id")
  contaResultadoId String @map("conta_resultado_id")
  /// DECIMAL: movimentação do mês.
  valorMovimento Decimal @map("valor_movimento")

  // --- origem, como veio no arquivo ---
  /// Código e nome do centro de custo no arquivo, gravados mesmo quando o
  /// centro não está no cadastro — é o caso dos centros de obra (1.98, 1.99).
  /// Com eles a classificação resolve o centro de novo depois de o cadastro
  /// ser corrigido, sem reimportar.
  codigoCentroCusto String? @map("codigo_centro_custo")
  nomeCentroCusto   String? @map("nome_centro_custo")
  /// Linha da planilha de origem, para o relatório e a conferência.
  linhaArquivo      Int     @map("linha_arquivo")
  /// O detalhe do movimento (15/10/2026), do balancete detalhado (colunas CLI_FORN, EMISSAO e HISTORICO do
  /// Balancete (Lista)): o cliente ou fornecedor, a data de emissão e o histórico. Nulos no balancete agregado.
  cliForn           String? @map("cli_forn")
  emissao           DateTime?
  historico         String?

  // --- campos derivados, recalculados a cada apuração e congelados com ela ---
  /// Conta que vale na DRE: a do balancete, ou a do cadastro de
  /// reclassificação para este centro e esta conta. É a coluna CONTA (ADOT.).
  contaAdotadaId String?  @map("conta_adotada_id")
  /// Quando a classificação foi calculada pela última vez.
  classificadoEm DateTime? @map("classificado_em")
  departamento String?
  atribuicao   String?
  linhaDREId   String?              @map("linha_dre_id")
  balde        BaldeAlocacao?       @map("balde")
  alocacao     TipoAlocacao?
  /// Chave de agregação: departamento.atribuicao.conta, prefixada pelo rateio
  /// quando houver. É o equivalente da coluna ETIQUETA da planilha.
  etiqueta     String?
  validacao    ValidacaoLancamento  @default(OK)

  criadoEm DateTime @default(now()) @map("criado_em")

  competencia    Competencia    @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  importacao     Importacao     @relation(fields: [importacaoId], references: [id])
  centroCusto    CentroCusto?   @relation(fields: [centroCustoId], references: [id], onDelete: Restrict)
  contaResultado ContaResultado @relation(fields: [contaResultadoId], references: [id])
  contaAdotada   ContaResultado? @relation("ContaAdotada", fields: [contaAdotadaId], references: [id])
  linhaDRE       LinhaDRE?      @relation(fields: [linhaDREId], references: [id])

  @@index([competenciaId, validacao])
  @@index([competenciaId, etiqueta])
  @@index([competenciaId, filial])
  @@map("lancamentos_contabeis")
}

/// Lançamento que não vem do ERP — hoje é o canal da RN, cujas movimentações
/// não são lançadas no TOTVS RM, e de ajustes como depreciação.
model LancamentoManual {
  id               String       @id @default(uuid())
  competenciaId    String       @map("competencia_id")
  motivo           String
  filial           Int
  centroCustoId    String?      @map("centro_custo_id")
  contaResultadoId String?      @map("conta_resultado_id")
  /// Texto livre; a tela sugere a descrição da conta, como a planilha fazia.
  descricao        String

  // --- derivados da conta (e do centro, quando houver), como as colunas E a I
  // da Gastos (Lanç. Manuais); recalculados ao gravar e a cada reclassificação,
  // e congelados com a apuração ---
  /// Rateio: o do centro, se houver centro; senão o da conta.
  balde            BaldeAlocacao? @map("balde")
  /// Destino na DRE: a linha da conta. Nulo se a conta perder o vínculo.
  linhaDREId       String?      @map("linha_dre_id")
  /// DECIMAL: aritmética sempre em JavaScript.
  valor            Decimal
  criadoPor        String?      @map("criado_por")
  criadoEm         DateTime     @default(now()) @map("criado_em")
  atualizadoEm     DateTime     @updatedAt @map("atualizado_em")

  competencia    Competencia     @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  centroCusto    CentroCusto?    @relation(fields: [centroCustoId], references: [id], onDelete: Restrict)
  contaResultado ContaResultado? @relation(fields: [contaResultadoId], references: [id])
  linhaDRE       LinhaDRE?       @relation(fields: [linhaDREId], references: [id])

  @@index([competenciaId, motivo])
  @@map("lancamentos_manuais")
}

/// Saldo de estoque por obra e linha. CONGELADO na apuração.
model EstoqueSaldo {
  id            String   @id @default(uuid())
  competenciaId String   @map("competencia_id")
  obraId        String   @map("obra_id")
  linhaId         String? @map("linha_id")
  linha         Linha?  @relation(fields: [linhaId], references: [id])
  /// Linha como texto (ESTRUTURA, ALVEOLARES, ESTACAS): a chave do saldo é obra + linha.
  linhaTexto    String   @map("linha_texto")
  /// DECIMAL: movimento do mês (produção − expedição) e o valor dele.
  movimentoVolume Decimal @default(0) @map("movimento_volume")
  movimentoValor  Decimal @default(0) @map("movimento_valor")
  /// DECIMAL: preço líquido por m³ do movimento; nulo nas estacas (tabela, peça a peça).
  precoMovimento  Decimal? @map("preco_movimento")
  /// Como o movimento foi valorado; nulo sem movimento.
  criterio        CriterioReceita?
  /// DECIMAL: volume e valor do saldo, e preço médio do período.
  saldoVolume   Decimal  @map("saldo_volume")
  saldoValor    Decimal  @map("saldo_valor")
  precoMedio    Decimal  @map("preco_medio")
  apuradoEm     DateTime @default(now()) @map("apurado_em")
  congelado     Boolean  @default(false)

  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  obra        Obra        @relation(fields: [obraId], references: [id])

  @@unique([competenciaId, obraId, linhaTexto])
  @@map("estoque_saldos")
}

/// Saldo inicial do estoque por obra e linha: a aba Estoque (2025), o saldo
/// no fim de 2025. Fica no primeiro mês da ferramenta (01/2026), que parte
/// dele em vez do saldo de um mês anterior — não há competência de 12/2025.
model EstoqueSaldoInicial {
  id            String  @id @default(uuid())
  competenciaId String  @map("competencia_id")
  importacaoId  String  @map("importacao_id")
  obraId        String  @map("obra_id")
  linhaId       String? @map("linha_id")
  /// Linha como texto (ESTRUTURA, ALVEOLARES, ESTACAS), como no saldo apurado.
  linhaTexto    String  @map("linha_texto")
  /// DECIMAL: volume (m³) e valor fiscal do saldo.
  saldoVolume   Decimal @map("saldo_volume")
  saldoValor    Decimal @map("saldo_valor")

  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  importacao  Importacao  @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  obra        Obra        @relation(fields: [obraId], references: [id])
  linha       Linha?      @relation(fields: [linhaId], references: [id])

  @@unique([competenciaId, obraId, linhaTexto])
  @@map("estoque_saldos_iniciais")
}

/// Indicador gerencial importado: o valor do mês de um indicador que não sai
/// da DRE (quadro de lotação, fluxo de caixa, vendas, demanda…), das abas
/// Indicadores (Admin.) e Indicadores (Comercial). O nome é o do catálogo dos
/// indicadores (aba Realizado (SIG) do INDICADORES DE RESULTADO).
model IndicadorImportado {
  id            String  @id @default(uuid())
  competenciaId String  @map("competencia_id")
  importacaoId  String  @map("importacao_id")
  nome          String
  /// DECIMAL: o valor do mês, na unidade do indicador (percentuais como fração: 0,05 = 5%).
  valor         Decimal
  linhaArquivo  Int     @map("linha_arquivo")

  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  importacao  Importacao  @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@unique([competenciaId, nome])
  @@index([importacaoId])
  @@map("indicadores_importados")
}

/// Meta do orçamento: o valor orçado do mês de um indicador do catálogo, da
/// aba Metas (Orçamento) do INDICADORES DE RESULTADO. É a base do "vs. Orçado"
/// do Painel de Bordo.
/// Estrutura dos Indicadores (cadastro da Controladoria, 11/10/2026): os indicadores de resultado, com a fórmula
/// que os calcula — itens da DRE apurada, totalizadores das Listas, indicadores do Comercial e do Administrativo e
/// metas do orçamento, com + − × ÷ (formulaIndicador.ts). O nome identifica o indicador nas metas importadas, nos
/// valores digitados e no Painel de Bordo.
model IndicadorEstrutura {
  id           String   @id @default(uuid())
  /// ORDEM: posição na tela (a da aba Realizado (SIG)).
  ordem        Int      @default(0)
  grupo        String
  /// A numeração no grupo, como na planilha; vazia nos indicadores principais do grupo.
  numero       String   @default("")
  nome         String   @unique
  /// Comportamento: ↑ quanto maior, melhor; ↓ quanto menor, melhor; = acompanhamento; - sem sentido.
  sentido      String
  unidade      String
  /// O texto da metodologia da aba Metas, que a tela Indicadores mostra sob o nome.
  descricao    String?
  /// A fórmula (Metodologia); nula nos de cálculo do sistema.
  formula      String?
  /// O acumulado: SOMA, MEDIA_PONDERADA (pela fórmula do peso), ULTIMO ou SISTEMA (a conta fica no código).
  modo         String
  peso         String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([ordem])
  @@map("indicadores_estrutura")
}

model MetaImportada {
  id            String  @id @default(uuid())
  competenciaId String  @map("competencia_id")
  importacaoId  String  @map("importacao_id")
  nome          String
  /// DECIMAL: o valor orçado do mês, na unidade do indicador (percentuais como fração).
  valor         Decimal
  linhaArquivo  Int     @map("linha_arquivo")

  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  importacao  Importacao  @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@unique([competenciaId, nome])
  @@index([importacaoId])
  @@map("metas_importadas")
}

/// Indicador digitado na aba Comercial ou Administrativo das Listas: o valor
/// do mês que sobrepõe o importado (abas Indicadores (Comercial) e (Admin.)).
/// Uma nova importação da aba volta a valer: apaga os digitados dos
/// indicadores que ela traz.
model IndicadorDigitado {
  id            String   @id @default(uuid())
  competenciaId String   @map("competencia_id")
  nome          String
  /// DECIMAL: o valor do mês, na unidade do indicador (percentuais como fração).
  valor         Decimal
  digitadoPor   String   @map("digitado_por")
  digitadoEm    DateTime @default(now()) @map("digitado_em")

  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)

  @@unique([competenciaId, nome])
  @@map("indicadores_digitados")
}

// -----------------------------------------------------------------------------
// LISTAS OPERACIONAIS
//
// Treze entidades, uma por tipo, conforme decidido na entrevista. Compartilham a
// mesma forma base — competência, unidade, obra, linha, quantidade e unidade de
// medida — e cada uma acrescenta o que lhe é próprio.
//
// `importacaoId` é coluna indexada sem chave estrangeira, de propósito: é
// proveniência, usada para substituir um lote na reimportação, e criar treze
// relações inversas em `Importacao` só para isso poluiria o schema. A integridade
// que importa — competência, obra e unidade — está garantida por relação.
// -----------------------------------------------------------------------------

model Projeto {
  id               String        @id @default(uuid())
  competenciaId    String        @map("competencia_id")
  importacaoId     String?       @map("importacao_id")
  unidadeNegocioId String?       @map("unidade_negocio_id")
  obraId           String?       @map("obra_id")
  linhaId            String? @map("linha_id")
  linha            Linha?  @relation(fields: [linhaId], references: [id])
  quantidade       Decimal
  /// Data da liberação do projeto (coluna Data da Projetos (Lista)).
  data             DateTime?
  nomePeca         String?       @map("nome_peca")
  codigoPeca       String?       @map("codigo_peca")
  produto          String?
  grupo            String?
  secao            String?
  comprimento      Decimal?
  pesoKg           Decimal?      @map("peso_kg")
  /// Linha da planilha de origem, para o relatório e a conferência.
  linhaArquivo     Int?          @map("linha_arquivo")
  unidadeMedida    UnidadeMedida @default(M3) @map("unidade_medida")
  criadoPor        String?       @map("criado_por")
  criadoEm         DateTime      @default(now()) @map("criado_em")
  /// Última alteração do registro (digitado): entra no retrato das entradas da apuração.
  atualizadoEm     DateTime      @default(now()) @updatedAt @map("atualizado_em")

  competencia    Competencia     @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])
  obra           Obra?           @relation(fields: [obraId], references: [id])

  @@index([competenciaId])
  @@index([importacaoId])
  @@map("projetos")
}

model Producao {
  id               String        @id @default(uuid())
  competenciaId    String        @map("competencia_id")
  importacaoId     String?       @map("importacao_id")
  unidadeNegocioId String?       @map("unidade_negocio_id")
  obraId           String?       @map("obra_id")
  linhaId            String? @map("linha_id")
  linha            Linha?  @relation(fields: [linhaId], references: [id])
  grupo            String?
  secao            String?
  comprimento      Decimal?
  quantidadePecas  Int?          @map("quantidade_pecas")
  quantidade       Decimal
  data             DateTime?
  codigoControle   String?       @map("codigo_controle")
  produto          String?
  nomePeca         String?       @map("nome_peca")
  /// Linha da planilha de origem, para o relatório e a conferência.
  linhaArquivo     Int?          @map("linha_arquivo")
  unidadeMedida    UnidadeMedida @default(M3) @map("unidade_medida")
  criadoPor        String?       @map("criado_por")
  criadoEm         DateTime      @default(now()) @map("criado_em")
  /// Última alteração do registro (digitado): entra no retrato das entradas da apuração.
  atualizadoEm     DateTime      @default(now()) @updatedAt @map("atualizado_em")

  competencia    Competencia     @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])
  obra           Obra?           @relation(fields: [obraId], references: [id])

  @@index([competenciaId, linhaId])
  @@index([importacaoId])
  @@map("producoes")
}

model ProducaoPista {
  id               String        @id @default(uuid())
  competenciaId    String        @map("competencia_id")
  importacaoId     String?       @map("importacao_id")
  unidadeNegocioId String?       @map("unidade_negocio_id")
  obraId           String?       @map("obra_id")
  linhaId            String? @map("linha_id")
  linha            Linha?  @relation(fields: [linhaId], references: [id])
  quantidade       Decimal
  /// Dia da produção. A linha (alveolares ou estacas) diz de que pista é.
  data             DateTime?
  /// Linha da planilha de origem, para o relatório e a conferência.
  linhaArquivo     Int?          @map("linha_arquivo")
  unidadeMedida    UnidadeMedida @default(PISTA) @map("unidade_medida")
  criadoPor        String?       @map("criado_por")
  criadoEm         DateTime      @default(now()) @map("criado_em")
  /// Última alteração do registro (digitado): entra no retrato das entradas da apuração.
  atualizadoEm     DateTime      @default(now()) @updatedAt @map("atualizado_em")

  competencia    Competencia     @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])
  obra           Obra?           @relation(fields: [obraId], references: [id])

  @@index([competenciaId])
  @@index([importacaoId])
  @@map("producoes_pista")
}

model ProducaoArmadura {
  id               String        @id @default(uuid())
  competenciaId    String        @map("competencia_id")
  importacaoId     String?       @map("importacao_id")
  unidadeNegocioId String?       @map("unidade_negocio_id")
  obraId           String?       @map("obra_id")
  linhaId            String? @map("linha_id")
  linha            Linha?  @relation(fields: [linhaId], references: [id])
  quantidade       Decimal
  /// Rótulo da linha na Produção (Lista Arm.): "Matriz (kg)", "Ferragem (kg)"…
  /// É ela que diz para qual destino do rateio de armadura o peso vai.
  categoria        String?
  /// Linha da planilha de origem, para o relatório e a conferência.
  linhaArquivo     Int?          @map("linha_arquivo")
  unidadeMedida    UnidadeMedida @default(KG) @map("unidade_medida")
  criadoPor        String?       @map("criado_por")
  criadoEm         DateTime      @default(now()) @map("criado_em")
  /// Última alteração do registro (digitado): entra no retrato das entradas da apuração.
  atualizadoEm     DateTime      @default(now()) @updatedAt @map("atualizado_em")

  competencia    Competencia     @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])
  obra           Obra?           @relation(fields: [obraId], references: [id])

  @@index([competenciaId])
  @@index([importacaoId])
  @@map("producoes_armadura")
}

model ProducaoMetalurgia {
  id               String        @id @default(uuid())
  competenciaId    String        @map("competencia_id")
  importacaoId     String?       @map("importacao_id")
  unidadeNegocioId String?       @map("unidade_negocio_id")
  obraId           String?       @map("obra_id")
  /// Finalidade do item metálico: INSERTO METÁLICO, FERRAGEM, MANUTENÇÃO etc.
  /// É ela que direciona o rateio da metalurgia entre as unidades.
  finalidade       String?
  /// A linha da coluna LINHA da Produção Mensal (incluída em 09/10/2026).
  linhaId          String?       @map("linha_id")
  linha            Linha?        @relation(fields: [linhaId], references: [id])
  quantidade       Decimal
  /// Linha da planilha de origem, para o relatório e a conferência.
  linhaArquivo     Int?          @map("linha_arquivo")
  unidadeMedida    UnidadeMedida @default(KG) @map("unidade_medida")
  criadoPor        String?       @map("criado_por")
  criadoEm         DateTime      @default(now()) @map("criado_em")
  /// Última alteração do registro (digitado): entra no retrato das entradas da apuração.
  atualizadoEm     DateTime      @default(now()) @updatedAt @map("atualizado_em")

  competencia    Competencia     @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])
  obra           Obra?           @relation(fields: [obraId], references: [id])

  @@index([competenciaId, finalidade])
  @@index([importacaoId])
  @@map("producoes_metalurgia")
}

model Expedicao {
  id               String        @id @default(uuid())
  competenciaId    String        @map("competencia_id")
  importacaoId     String?       @map("importacao_id")
  unidadeNegocioId String?       @map("unidade_negocio_id")
  obraId           String?       @map("obra_id")
  linhaId            String? @map("linha_id")
  linha            Linha?  @relation(fields: [linhaId], references: [id])
  /// DECIMAL: frete cobrado na expedição, base da receita de frete.
  valorFrete       Decimal?      @map("valor_frete")
  quantidade       Decimal
  /// quantidade é o VOLUME ADOTADO: o informado, ou o calculado pela seção e
  /// comprimento da peça, ou o peso / 2.500 — a regra da coluna V. Adot. (m³).
  data             DateTime?
  numeroCarga      String?       @map("numero_carga")
  nomePeca         String?       @map("nome_peca")
  codigoControle   String?       @map("codigo_controle")
  pesoKg           Decimal?      @map("peso_kg")
  volumeInformado  Decimal?      @map("volume_informado")
  /// Linha da planilha de origem, para o relatório e a conferência.
  linhaArquivo     Int?          @map("linha_arquivo")
  unidadeMedida    UnidadeMedida @default(M3) @map("unidade_medida")
  criadoPor        String?       @map("criado_por")
  criadoEm         DateTime      @default(now()) @map("criado_em")
  /// Última alteração do registro (digitado): entra no retrato das entradas da apuração.
  atualizadoEm     DateTime      @default(now()) @updatedAt @map("atualizado_em")

  competencia    Competencia     @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])
  obra           Obra?           @relation(fields: [obraId], references: [id])

  @@index([competenciaId, linhaId])
  @@index([importacaoId])
  @@map("expedicoes")
}

model Montagem {
  id               String        @id @default(uuid())
  competenciaId    String        @map("competencia_id")
  importacaoId     String?       @map("importacao_id")
  unidadeNegocioId String?       @map("unidade_negocio_id")
  obraId           String?       @map("obra_id")
  linhaId            String? @map("linha_id")
  linha            Linha?  @relation(fields: [linhaId], references: [id])
  quantidade       Decimal
  data             DateTime?
  grupo            String?
  secao            String?
  quantidadePecas  Decimal?      @map("quantidade_pecas")
  /// Linha da planilha de origem, para o relatório e a conferência.
  linhaArquivo     Int?          @map("linha_arquivo")
  unidadeMedida    UnidadeMedida @default(M3) @map("unidade_medida")
  criadoPor        String?       @map("criado_por")
  criadoEm         DateTime      @default(now()) @map("criado_em")
  /// Última alteração do registro (digitado): entra no retrato das entradas da apuração.
  atualizadoEm     DateTime      @default(now()) @updatedAt @map("atualizado_em")

  competencia    Competencia     @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])
  obra           Obra?           @relation(fields: [obraId], references: [id])

  @@index([competenciaId])
  @@index([importacaoId])
  @@map("montagens")
}

model Acompanhamento {
  id               String        @id @default(uuid())
  competenciaId    String        @map("competencia_id")
  importacaoId     String?       @map("importacao_id")
  unidadeNegocioId String?       @map("unidade_negocio_id")
  obraId           String?       @map("obra_id")
  linhaId            String? @map("linha_id")
  linha            Linha?  @relation(fields: [linhaId], references: [id])
  quantidade       Decimal
  /// Etapa da obra acompanhada (MONTAGEM, FUNDAÇÃO, SAC…). MONTAGEM e SAC
  /// contam para o rateio da Montagem; as demais, para o Complementar.
  etapa            String?
  observacao       String?
  /// Linha da planilha de origem, para o relatório e a conferência.
  linhaArquivo     Int?          @map("linha_arquivo")
  unidadeMedida    UnidadeMedida @default(DIA) @map("unidade_medida")
  criadoPor        String?       @map("criado_por")
  criadoEm         DateTime      @default(now()) @map("criado_em")
  /// Última alteração do registro (digitado): entra no retrato das entradas da apuração.
  atualizadoEm     DateTime      @default(now()) @updatedAt @map("atualizado_em")

  competencia    Competencia     @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])
  obra           Obra?           @relation(fields: [obraId], references: [id])

  @@index([competenciaId])
  @@index([importacaoId])
  @@map("acompanhamentos")
}

model Medicao {
  id               String        @id @default(uuid())
  competenciaId    String        @map("competencia_id")
  importacaoId     String?       @map("importacao_id")
  unidadeNegocioId String?       @map("unidade_negocio_id")
  obraId           String?       @map("obra_id")
  linhaId            String? @map("linha_id")
  linha            Linha?  @relation(fields: [linhaId], references: [id])
  /// DECIMAL: valor medido no período, usado na conferência do faturamento.
  valorMedido      Decimal?      @map("valor_medido")
  /// quantidade é a diferença de execução do mês (Exec. Atual − Exec. Ant.);
  /// valorMedido = quantidade × valorFaturamento, a ROB Serviços da planilha.
  quantidade       Decimal
  tipoLancamento   String?       @map("tipo_lancamento")
  cliente          String?
  tipoFaturamento  String?       @map("tipo_faturamento")
  /// DECIMAL: Fat. BPM (R$), o valor do tipo de faturamento no contrato.
  valorFaturamento Decimal?      @map("valor_faturamento")
  execucaoAnterior Decimal?      @map("execucao_anterior")
  execucaoAtual    Decimal?      @map("execucao_atual")
  linhaArquivo     Int?          @map("linha_arquivo")
  unidadeMedida    UnidadeMedida @default(M3) @map("unidade_medida")
  criadoPor        String?       @map("criado_por")
  criadoEm         DateTime      @default(now()) @map("criado_em")

  competencia    Competencia     @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])
  obra           Obra?           @relation(fields: [obraId], references: [id])

  @@index([competenciaId])
  @@index([importacaoId])
  @@map("medicoes")
}

model Devolucao {
  id               String        @id @default(uuid())
  competenciaId    String        @map("competencia_id")
  importacaoId     String?       @map("importacao_id")
  unidadeNegocioId String?       @map("unidade_negocio_id")
  obraId           String?       @map("obra_id")
  linhaId            String? @map("linha_id")
  linha            Linha?  @relation(fields: [linhaId], references: [id])
  tipoMovimentoId  String?       @map("tipo_movimento_id")
  /// DECIMAL: valor devolvido.
  valor            Decimal?
  quantidade       Decimal
  /// Colunas da nota fiscal, como vêm do RM.
  data             DateTime?
  notaFiscal       String?       @map("nota_fiscal")
  filial           Int?
  codigoProduto    String?       @map("codigo_produto")
  descricao        String?
  /// Código do tipo de movimento (ex.: 1.2.18); tipoMovimentoId quando cadastrado.
  movimento        String?
  /// Descrição do movimento (NM_TIPO_MOV nas saídas, Tipo movimento nas devoluções).
  nomeMovimento    String?       @map("nome_movimento")
  /// DECIMAL: ICMS + PIS + COFINS, zero em obra de venda global — as deduções da receita.
  creditos         Decimal?
  linhaArquivo     Int?          @map("linha_arquivo")
  unidadeMedida    UnidadeMedida @default(M3) @map("unidade_medida")
  criadoPor        String?       @map("criado_por")
  criadoEm         DateTime      @default(now()) @map("criado_em")

  competencia    Competencia     @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])
  obra           Obra?           @relation(fields: [obraId], references: [id])
  tipoMovimento  TipoMovimento?  @relation(fields: [tipoMovimentoId], references: [id])

  @@index([competenciaId])
  @@index([importacaoId])
  @@map("devolucoes")
}

model Saida {
  id               String        @id @default(uuid())
  competenciaId    String        @map("competencia_id")
  importacaoId     String?       @map("importacao_id")
  unidadeNegocioId String?       @map("unidade_negocio_id")
  obraId           String?       @map("obra_id")
  linhaId            String? @map("linha_id")
  linha            Linha?  @relation(fields: [linhaId], references: [id])
  tipoMovimentoId  String?       @map("tipo_movimento_id")
  /// DECIMAL: valor da saída.
  valor            Decimal?
  quantidade       Decimal
  /// Colunas da nota fiscal, como vêm do RM.
  data             DateTime?
  notaFiscal       String?       @map("nota_fiscal")
  filial           Int?
  codigoProduto    String?       @map("codigo_produto")
  descricao        String?
  /// Código do tipo de movimento (ex.: 1.2.18); tipoMovimentoId quando cadastrado.
  movimento        String?
  /// Descrição do movimento (NM_TIPO_MOV nas saídas, Tipo movimento nas devoluções).
  nomeMovimento    String?       @map("nome_movimento")
  /// DECIMAL: ICMS + PIS + COFINS, zero em obra de venda global — as deduções da receita.
  creditos         Decimal?
  linhaArquivo     Int?          @map("linha_arquivo")
  unidadeMedida    UnidadeMedida @default(M3) @map("unidade_medida")
  criadoPor        String?       @map("criado_por")
  criadoEm         DateTime      @default(now()) @map("criado_em")

  competencia    Competencia     @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])
  obra           Obra?           @relation(fields: [obraId], references: [id])
  tipoMovimento  TipoMovimento?  @relation(fields: [tipoMovimentoId], references: [id])

  @@index([competenciaId])
  @@index([importacaoId])
  @@map("saidas")
}



// =============================================================================
// APURAÇÃO (Passo 5)
//
// O retrato da competência. Tudo aqui é CONGELADO na apuração: uma vez
// apurados, estes valores não mudam ainda que os cadastros de origem mudem.
// Só a reabertura da competência permite nova apuração — é o Princípio de
// Congelamento da Apuração descrito no SPEC.md.
// =============================================================================

/// ENUM: natureza da receita na prévia operacional.
enum NaturezaReceita {
  PRE_FABRICADO
  FRETE
  MONTAGEM
  COMPLEMENTAR
  DEVOLUCOES_INVENTARIOS
}

/// Receita apurada a partir das listas operacionais valoradas.
///
/// É GRAVADA COMO VALOR, não recalculada quando consultada. Guarda quais preços
/// de contrato usou, de modo que a apuração continue explicável mesmo depois de
/// a equipe comercial atualizar a DRE de venda de uma obra já em produção — que
/// é exatamente o motivo pelo qual, na planilha, essas fórmulas foram
/// convertidas em valores à mão.
model ReceitaPrevia {
  id               String          @id @default(uuid())
  competenciaId    String          @map("competencia_id")
  unidadeNegocioId String          @map("unidade_negocio_id")
  natureza         NaturezaReceita
  /// DECIMAL: receita bruta, impostos e receita líquida.
  receitaBruta     Decimal         @map("receita_bruta")
  impostos         Decimal
  receitaLiquida   Decimal         @map("receita_liquida")
  /// DECIMAL: variação do estoque (CPP) que acompanha a natureza — na
  /// Filial, a das estacas, valorada pela tabela de estacas.
  variacaoEstoque  Decimal         @default(0) @map("variacao_estoque")
  apuradoEm        DateTime        @default(now()) @map("apurado_em")
  congelado        Boolean         @default(false)

  competencia    Competencia    @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio @relation(fields: [unidadeNegocioId], references: [id])

  /// LISTA: preços de contrato usados nesta valoração.
  precos ReceitaPreviaPreco[]
  /// LISTA: memória de cálculo, um item por registro de lista ou lançamento.
  itens  ReceitaPreviaItem[]

  @@unique([competenciaId, unidadeNegocioId, natureza])
  @@map("receitas_previas")
}

/// LISTA-DE: ReceitaPrevia.precoContratoIds
///
/// Qual preço valorou qual receita. Virou tabela de relação pelo mesmo motivo
/// das demais listas — e aqui a relação é indispensável, porque é ela que torna
/// a apuração auditável depois que o preço vigente muda.
model ReceitaPreviaPreco {
  receitaPreviaId String @map("receita_previa_id")
  precoContratoId String @map("preco_contrato_id")

  receitaPrevia ReceitaPrevia @relation(fields: [receitaPreviaId], references: [id], onDelete: Cascade)
  precoContrato PrecoContrato @relation(fields: [precoContratoId], references: [id])

  @@id([receitaPreviaId, precoContratoId])
  @@index([precoContratoId])
  @@map("receitas_previas_precos")
}

/// Volume físico realizado por chave de rateio, e a participação de cada
/// unidade. O percentual NUNCA é digitado — é calculado aqui.
model VolumeOperacional {
  id               String   @id @default(uuid())
  competenciaId    String   @map("competencia_id")
  regraRateioId    String   @map("regra_rateio_id")
  unidadeNegocioId String   @map("unidade_negocio_id")
  /// DECIMAL: volume físico realizado no mês.
  quantidade       Decimal
  /// DECIMAL: participação na chave. A soma por chave é 1, ou 0 sem volume.
  percentual       Decimal
  apuradoEm        DateTime @default(now()) @map("apurado_em")
  congelado        Boolean  @default(false)

  competencia    Competencia    @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  regraRateio    RegraRateio    @relation(fields: [regraRateioId], references: [id])
  unidadeNegocio UnidadeNegocio @relation(fields: [unidadeNegocioId], references: [id])

  @@unique([competenciaId, regraRateioId])
  @@map("volumes_operacionais")
}

/// A DRE apurada. Uma linha por (competência × visão × linha da DRE).
///
/// A visão é dada por `unidadeNegocioId` OU `centroCustoId`: com unidade, é a
/// DRE daquela unidade; com centro de custo, a visão por centro; com os dois
/// nulos, o consolidado.
model ResultadoApurado {
  id               String   @id @default(uuid())
  competenciaId    String   @map("competencia_id")
  unidadeNegocioId String?  @map("unidade_negocio_id")
  centroCustoId    String?  @map("centro_custo_id")
  linhaDREId       String   @map("linha_dre_id")
  /// DECIMAL: valor apurado e participação sobre a ROL.
  valor            Decimal
  percentualROL    Decimal? @map("percentual_rol")
  /// JSON: como o valor foi formado — a regra, a soma dos diretos e cada rateio
  /// com base e percentual. É a memória de cálculo e o ponto de partida do detalhamento.
  composicao       Json? @db.Json
  apuradoEm        DateTime @default(now()) @map("apurado_em")
  apuradoPor       String?  @map("apurado_por")
  congelado        Boolean  @default(false)

  competencia    Competencia     @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio? @relation(fields: [unidadeNegocioId], references: [id])
  centroCusto    CentroCusto?    @relation(fields: [centroCustoId], references: [id], onDelete: Restrict)
  linhaDRE       LinhaDRE        @relation(fields: [linhaDREId], references: [id])

  @@unique([competenciaId, unidadeNegocioId, centroCustoId, linhaDREId])
  @@index([competenciaId, linhaDREId])
  @@map("resultados_apurados")
}

/// Os Resultados por Linha (26/10/2026): o valor de cada linha de produto e de obra — ou da Sem Linha da unidade — em
/// cada item da DRE (receitas, custos, despesas variáveis de venda e volumes), gravado pela etapa Linhas da apuração e
/// congelado com a competência no fechamento. A soma das linhas de uma unidade é a DRE apurada dela.
model ResultadoLinha {
  id            String  @id @default(uuid())
  competenciaId String  @map("competencia_id")
  /// A unidade pelo código: 1 Matriz, 2 Filial, 3 Serviços.
  unidade       Int
  /// Nulo: a Sem Linha da unidade (o que nenhum passo da Alocação nas Linhas levou a uma linha).
  linhaId       String? @map("linha_id")
  linhaDREId    String  @map("linha_dre_id")
  /// DECIMAL: o valor da linha no item.
  valor         Decimal
  /// DECIMAL: a parte do valor que veio dos centros de obra (direta nas obras); o resto é o que a aba Rateios por Obras
  /// leva às obras.
  naObra        Decimal @default(0) @map("na_obra")

  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  linha       Linha?      @relation(fields: [linhaId], references: [id], onDelete: Restrict)
  linhaDRE    LinhaDRE    @relation(fields: [linhaDREId], references: [id])

  @@index([competenciaId, linhaId])
  @@index([linhaId])
  @@map("resultados_linhas")
}

/// Reclassificação de conta por centro de custo — a versão de cadastro da
/// coluna CONTA (ALOC.) da planilha. Corrige o lançamento que o RM gravou numa
/// conta de outro departamento ou de outra atribuição (folha, requisição, nota
/// fiscal lançadas no centro errado): para este centro, a conta de origem vale
/// como a conta de destino.
///
/// Fica no cadastro, e não no lançamento, pela regra do SPEC — a correção é
/// sempre no cadastro. Vale para todas as competências ainda não apuradas.
/// O centro é identificado pelo CÓDIGO do RM, como no balancete.
model ReclassificacaoConta {
  id                String   @id @default(uuid())
  codigoCentroCusto String   @map("codigo_centro_custo")
  contaOrigemId     String   @map("conta_origem_id")
  contaDestinoId    String   @map("conta_destino_id")
  motivo            String?
  /// ORDEM: posição na tela, reorganizável pelo usuário.
  ordem             Int      @default(0)
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now()) @map("criado_em")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  contaOrigem  ContaResultado @relation("ReclassificacaoOrigem", fields: [contaOrigemId], references: [id])
  contaDestino ContaResultado @relation("ReclassificacaoDestino", fields: [contaDestinoId], references: [id])

  @@unique([codigoCentroCusto, contaOrigemId])
  @@map("reclassificacoes_conta")
}

/// De onde veio cada parcela da receita prévia.
enum OrigemReceita {
  PRODUCAO
  EXPEDICAO
  SAIDA
  DEVOLUCAO
  MEDICAO
  LANCAMENTO
}

/// Como o item foi valorado — as colunas Cad.? das abas de receita.
enum CriterioReceita {
  /// Preço da DRE do Comercial, versão 0.
  CONTRATO
  /// Obra sem DRE: preço padrão por linha ("X").
  SEM_CONTRATO
  /// Obra genérica (G11, M2, M3, M9999): preço padrão ("E").
  GENERICA
  /// Linha incoerente com a unidade: preço padrão ("L").
  LINHA_INCONSISTENTE
  /// Estaca valorada pela tabela de estacas.
  TABELA_ESTACA
  /// Valor da nota fiscal (saídas e devoluções).
  NOTA_FISCAL
  /// Medição: diferença de execução × Fat. BPM.
  MEDICAO
  LANCAMENTO
}

/// Parte da receita prévia que um lançamento manual ajusta.
enum ComponenteReceita {
  BRUTA
  LIQUIDA
  VARIACAO_ESTOQUE
}

/// Memória de cálculo da receita prévia: congelada junto com ela.
model ReceitaPreviaItem {
  id              String          @id @default(uuid())
  receitaPreviaId String          @map("receita_previa_id")
  origem          OrigemReceita
  /// Registro de origem (lista ou lançamento); só referência, sem chave
  /// estrangeira, porque a lista pode ser reimportada depois da apuração.
  registroId      String?         @map("registro_id")
  obraCodigo      String?         @map("obra_codigo")
  linha           String?
  /// DECIMAL: volume, quantidade ou fração executada, conforme a origem.
  quantidade      Decimal?
  criterio        CriterioReceita
  /// DECIMAL: preço unitário bruto e líquido usados.
  precoBruto      Decimal?        @map("preco_bruto")
  precoLiquido    Decimal?        @map("preco_liquido")
  precoBrutoId    String?         @map("preco_bruto_id")
  precoLiquidoId  String?         @map("preco_liquido_id")
  receitaBruta    Decimal         @default(0) @map("receita_bruta")
  receitaLiquida  Decimal         @default(0) @map("receita_liquida")
  variacaoEstoque Decimal         @default(0) @map("variacao_estoque")
  observacao      String?
  /// Venda global ou mercantil do item, que separa as receitas e os impostos
  /// da Matriz e da Filial na receita prévia: pela obra (código começando com
  /// "G" é global) ou, no lançamento manual, pelo campo dele. Nulo nas
  /// medições de Obras, que não se separam.
  venda           TipoVenda?
  /// O que separa as linhas da obra nas abas de receita do BASE PRÉVIAS: a
  /// peça da estaca (produção e expedição), o movimento (saídas e devoluções)
  /// ou o tipo de faturamento (medições).
  detalhe         String?
  /// Descrição do movimento das saídas e devoluções, ao lado do código em detalhe.
  detalheDescricao String?      @map("detalhe_descricao")

  receitaPrevia ReceitaPrevia @relation(fields: [receitaPreviaId], references: [id], onDelete: Cascade)

  @@index([receitaPreviaId])
  @@map("receitas_previas_itens")
}

/// Lançamento manual de receita — a aba Receita (Lanç. Manuais) do BASE
/// PRÉVIAS: correções e redistribuições digitadas pelo Contábil.
model LancamentoReceita {
  id               String            @id @default(uuid())
  competenciaId    String            @map("competencia_id")
  unidadeNegocioId String            @map("unidade_negocio_id")
  natureza         NaturezaReceita
  componente       ComponenteReceita
  /// DECIMAL: aritmética sempre em JavaScript.
  valor            Decimal
  observacao       String
  /// Venda global ou mercantil (coluna VENDA da aba): obrigatória na Matriz e
  /// na Filial, nula em Obras, que não se separam.
  venda            TipoVenda?
  criadoPor        String?           @map("criado_por")
  criadoEm         DateTime          @default(now()) @map("criado_em")
  atualizadoEm     DateTime          @updatedAt @map("atualizado_em")

  competencia    Competencia    @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  unidadeNegocio UnidadeNegocio @relation(fields: [unidadeNegocioId], references: [id])

  @@index([competenciaId])
  @@map("lancamentos_receita")
}

/// Conferência da DRE apurada contra a DRE da planilha, no período de paralelo
/// (Passo 27, RF013). Guarda os valores que o arquivo traz para o mês, por aba
/// e linha, já ligados às linhas da estrutura; a comparação com a DRE é feita
/// na consulta, com o limite de arredondamento pedido, de modo que uma
/// reapuração aparece sem reenviar o arquivo. O arquivo não fica guardado, só
/// o hash, como nas importações.
model ConferenciaPlanilha {
  id            String   @id @default(uuid())
  competenciaId String   @map("competencia_id")
  nomeArquivo   String   @map("nome_arquivo")
  hashArquivo   String   @map("hash_arquivo")
  enviadoPor    String   @map("enviado_por")
  enviadoEm     DateTime @default(now()) @map("enviado_em")
  /// JSON: [{ unidade (0 = consolidado), aba, linha, descricao, codigo, valor }]
  /// — codigo é a linha da estrutura ligada pela descrição, ou null.
  valores       Json @db.Json
  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  usuario     Usuario     @relation(fields: [enviadoPor], references: [id])

  @@index([competenciaId, enviadoEm])
  @@map("conferencias_planilha")
}

/// Criação de Cenários (11/10/2026): um cenário sintético é uma DRE por unidade, mês a mês no exercício, com as metas
/// dos indicadores — importado de uma planilha como o ORÇAMENTO BPM (abas Consolidado, Matriz, Filial, Serviços,
/// Desp.+Extra e RN) e a aba Metas do INDICADORES DE RESULTADO. Os cenários analíticos virão depois.
enum MarcacaoCenario {
  ORCAMENTO_EMPRESARIAL
  RESULTADOS_ANTERIORES
  RESULTADOS_VENDIDOS
  /// A Previsão (21/10/2026): um cenário que se escolhe no Compara Com de Resultados Empresariais.
  PREVISAO
}

/// Quem vê o cenário (11/10/2026): PARTICULAR, só quem o criou e o Administrador (Editar no Controle de Usuários);
/// PUBLICA, todos os usuários com permissão nos Cenários Sintéticos.
enum VisualizacaoCenario {
  PARTICULAR
  PUBLICA
}

model Cenario {
  id           String           @id @default(uuid())
  nome         String
  /// O exercício do cenário (os meses JAN a DEZ dele).
  ano          Int
  /// SINTETICO (agora) ou ANALITICO (depois).
  tipo         String           @default("SINTETICO")
  descricao    String?
  /// O papel do cenário; cada marcação fica ativa em um cenário só por vez (11/10/2026; antes, uma por exercício). O
  /// Orçamento Empresarial dá o orçado de Resultados Realizados do exercício dele.
  marcacao     MarcacaoCenario?
  /// O último arquivo importado no cenário.
  nomeArquivo  String?          @map("nome_arquivo")
  importadoEm  DateTime?        @map("importado_em")
  criadoPor    String?          @map("criado_por")
  /// O usuário que criou o cenário: com ele, o Administrador vê o cenário particular.
  criadoPorId  String?          @map("criado_por_id")
  /// Particular ou pública; um cenário marcado é sempre público (o Orçamento Empresarial dá o orçado a todos).
  visualizacao VisualizacaoCenario @default(PUBLICA)
  /// O comparativo (12/10/2026): o cenário com que este se compara; com ele, as contas que variam acima da variação
  /// máxima do total delas pedem justificativa (tela Justificativas).
  comparadoComId   String?  @map("comparado_com_id")
  /// A variação máxima (em %) de cada total da DRE no comparativo: { código do total: percentual }.
  variacoesMaximas Json? @db.Json @map("variacoes_maximas")
  /// Os Índices de Reajuste do cenário analítico (19/10/2026; Configurações / Índices): [{ chave, descricao, observacao,
  /// variacao (%) }]. No Comparativo dos analíticos, cada conta escolhe um índice (no lugar da variação digitada).
  indicesReajuste  Json? @db.Json @map("indices_reajuste")
  /// O índice de cada conta no Comparativo dos analíticos: { código da linha da DRE: chave do índice }.
  indicesDoComparativo Json? @db.Json @map("indices_do_comparativo")
  /// As movimentações do realizado fora dos padrões das premissas (cenário analítico, 14/10/2026): as da última carga
  /// do resultado realizado, as decisões de realocação (o grupo de centros de custo de cada conta; mantidas entre as
  /// cargas) e o que está somado nos centros por elas. Ver services/cenarios/realocacoesCenario.ts.
  realocacoes      Json? @db.Json @map("realocacoes")
  /// As regras de rateio do último cálculo do cenário analítico (14/10/2026): o id e a data de alteração de cada uma. Se
  /// as regras de hoje são outras (editadas, criadas ou excluídas), a tela Resultados pede o Recalcular.
  rateiosAssinatura String? @map("rateios_assinatura")
  /// O versionamento (13/10/2026): a versão do cenário (0 = VER00); a família (o id da VER00; nulo na própria VER00) e
  /// a versão de que esta é revisão. Salvar Versão congela o cenário (como o fechamento de uma competência): a DRE, os
  /// indicadores manuais e a referência não se editam mais; Criar Revisão copia o cenário salvo numa versão nova.
  versao           Int       @default(0)
  familiaId        String?   @map("familia_id")
  revisaoDeId      String?   @map("revisao_de_id")
  versaoSalvaEm    DateTime? @map("versao_salva_em")
  versaoSalvaPor   String?   @map("versao_salva_por")
  criadoEm     DateTime         @default(now()) @map("criado_em")
  atualizadoEm DateTime         @updatedAt @map("atualizado_em")

  comparadoCom   Cenario?  @relation("ComparativoDoCenario", fields: [comparadoComId], references: [id], onDelete: SetNull)
  comparadoPor   Cenario[] @relation("ComparativoDoCenario")
  resultados     CenarioResultado[]
  indicadores    CenarioIndicador[]
  reajustes      CenarioReajuste[]
  justificativas CenarioJustificativa[]
  justificativasPremissas CenarioPremissaJustificativa[]
  premissas      CenarioPremissa[]
  centros        CenarioCentro[]
  investimentos  CenarioInvestimento[]

  @@unique([marcacao])
  @@map("cenarios")
}

/// O valor de uma linha da DRE do cenário, numa visão (0 Consolidado, 1 a 5 as unidades), num mês.
model CenarioResultado {
  cenarioId  String  @map("cenario_id")
  visao      Int
  linhaDREId String  @map("linha_dre_id")
  mes        Int
  valor      Decimal

  cenario  Cenario  @relation(fields: [cenarioId], references: [id], onDelete: Cascade)
  linhaDRE LinhaDRE @relation(fields: [linhaDREId], references: [id])

  @@id([cenarioId, visao, linhaDREId, mes])
  @@index([linhaDREId])
  @@map("cenarios_resultados")
}

/// A meta de um indicador no cenário, num mês, pelo nome do indicador: importada (aba Metas) ou digitada (os
/// lançamentos manuais: quadros de lotação, Comercial e Administrativo).
model CenarioIndicador {
  cenarioId String  @map("cenario_id")
  nome      String
  mes       Int
  valor     Decimal
  /// IMPORTADO ou DIGITADO.
  origem    String  @default("IMPORTADO")

  cenario Cenario @relation(fields: [cenarioId], references: [id], onDelete: Cascade)

  @@id([cenarioId, nome, mes])
  @@map("cenarios_indicadores")
}

/// A justificativa de uma conta que varia acima da variação máxima do comparativo (12/10/2026), numa visão da DRE
/// (0 Consolidado, 1 a 5 as unidades).
model CenarioJustificativa {
  cenarioId    String   @map("cenario_id")
  visao        Int
  linhaDREId   String   @map("linha_dre_id")
  texto        String
  usuarioNome  String   @map("usuario_nome")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  cenario  Cenario  @relation(fields: [cenarioId], references: [id], onDelete: Cascade)
  linhaDRE LinhaDRE @relation(fields: [linhaDREId], references: [id])

  @@id([cenarioId, visao, linhaDREId])
  @@index([linhaDREId])
  @@map("cenarios_justificativas")
}

/// A justificativa de uma linha das premissas de um cenário analítico (15/10/2026): a coluna Justificativa do Exportar
/// Premissas, que volta pelo Importar Valores. A chave é o código da linha na planilha (P|unidade|venda|premissa,
/// C|grupo|conta, L|grupo|CLT ou PJ, E|grupo|item, B|unidade|conta, X|unidade|conta ou I|indicador).
model CenarioPremissaJustificativa {
  cenarioId    String   @map("cenario_id")
  chave        String
  texto        String
  usuarioNome  String   @map("usuario_nome")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  cenario Cenario @relation(fields: [cenarioId], references: [id], onDelete: Cascade)

  @@id([cenarioId, chave])
  @@map("cenarios_premissas_justificativas")
}

/// O histórico de reajustes de um cenário (12/10/2026): cada gravação de valores da DRE (o reajuste dos marcados ou a
/// edição de um valor) e cada carga de referência (arquivo ou resultado realizado), com quem, quando, o quê e as somas
/// antes e depois. A tela Reajustes do cenário mostra o histórico.
/// As premissas de um cenário analítico (13/10/2026): os valores digitados das tabelas Matriz, Filial e Serviços da
/// tela Premissas, por unidade (1 a 3), venda (GLOBAL ou MERCANTIL; em Serviços, só GLOBAL), chave e mês (1 a 12; o 0 é
/// a Média de Referência). A chave diz o que é: DIAS_UTEIS, AJUSTE_RECEITA, AJUSTE_CUSTOS (em %), DEMANDA:<linha>
/// (por dia útil; nas linhas de m³ e pistas, as pistas), M3_PISTA:<linha>, RB:<linha>:<conta ROB> e
/// CUSTO:<linha>:<conta> (R$ por unidade da linha) e IMPOSTOS:<linha> (%/ROB). O que não está gravado vale o padrão (os
/// dias úteis do calendário, zero no resto); a DRE do cenário se calcula a partir daqui (premissasCenario.ts).
model CenarioPremissa {
  cenarioId String  @map("cenario_id")
  unidade   Int
  venda     String
  chave     String
  mes       Int
  valor     Decimal

  cenario Cenario @relation(fields: [cenarioId], references: [id], onDelete: Cascade)

  @@id([cenarioId, unidade, venda, chave, mes])
  @@map("cenarios_premissas")
}

/// Os valores dos centros de custo de um cenário analítico (13/10/2026): o valor de cada conta da DRE (mão de obra,
/// terceirizados e gastos gerais diretos, indiretos e comerciais) de cada grupo de centros da Controladoria (o nome
/// da Controladoria), mês a mês, alocado às unidades pelo balde do grupo e pelos rateios do fechamento, com as bases
/// das premissas (centrosCenario.ts).
model CenarioCentro {
  cenarioId  String   @map("cenario_id")
  grupo      String
  linhaDREId String   @map("linha_dre_id")
  mes        Int
  valor      Decimal

  cenario  Cenario  @relation(fields: [cenarioId], references: [id], onDelete: Cascade)
  linhaDRE LinhaDRE @relation(fields: [linhaDREId], references: [id], onDelete: Cascade)

  @@id([cenarioId, grupo, linhaDREId, mes])
  @@index([linhaDREId])
  @@map("cenarios_centros")
}

/// Os investimentos de um cenário analítico (13/10/2026, aba Investimentos das Premissas): cada um deprecia, a partir
/// do mês de início, (valor total − valor pós uso) ÷ vida útil por mês, na conta de depreciação da unidade, somado à
/// depreciação base. O ROI = (receita bruta prevista − valor total) ÷ valor total, calculado.
model CenarioInvestimento {
  id                   String   @id @default(uuid())
  cenarioId            String   @map("cenario_id")
  /// A unidade da DRE: 1 Matriz, 2 Filial, 3 Serviços, 4 Despesas e Extra.
  unidade              Int
  /// A conta de depreciação (o código da linha da DRE): a do maquinário de produção, de serviços ou do patrimônio.
  conta                String
  /// O Nome de Referência (15/10/2026): digitado, único no cenário; a planilha das premissas reconhece o investimento por ele.
  nomeReferencia       String   @default("") @map("nome_referencia")
  descricao            String
  /// A condição de pagamento (19/10/2026; texto livre: à vista, 10x, entrada + 12x…). Antes, o Ganho Previsto e a Receita
  /// Bruta Prevista (com o ROI), removidos.
  condicaoPagamento    String?  @map("condicao_pagamento")
  /// O mês de início da depreciação (1 a 12, no exercício do cenário).
  inicio               Int
  valorTotal           Decimal  @map("valor_total")
  valorPosUso          Decimal  @default(0) @map("valor_pos_uso")
  /// A vida útil, em meses.
  vidaUtil             Int      @map("vida_util")
  ordem                Int      @default(0)
  criadoEm             DateTime @default(now()) @map("criado_em")
  atualizadoEm         DateTime @updatedAt @map("atualizado_em")

  cenario Cenario @relation(fields: [cenarioId], references: [id], onDelete: Cascade)

  @@unique([cenarioId, nomeReferencia])
  @@index([cenarioId])
  @@map("cenarios_investimentos")
}

/// A correspondência tarefa × linha (14/10/2026): a tarefa das requisições e das notas fiscais (o nome dela), numa
/// filial (nula: qualquer), e a linha de produto ou de obra dos custos dela. A referência realizada dos cenários
/// analíticos usa a correspondência para levar os custos de cada conta às linhas (as Médias de Referência das
/// premissas); o que não tem tarefa, ou tem uma tarefa sem correspondência, vai pelo volume das linhas.
model CorrespondenciaTarefa {
  id           String   @id @default(uuid())
  filial       Int?
  tarefa       String
  linhaId      String   @map("linha_id")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  linha Linha @relation(fields: [linhaId], references: [id], onDelete: Cascade)

  @@unique([filial, tarefa])
  @@map("correspondencias_tarefas")
}

/// A Alocação nas Linhas (26/10/2026, pedido do Adão; Cadastros da Controladoria › Controladoria): como os custos sem
/// tarefa chegam às linhas nos Resultados por Linha. Cada regra tem uma origem — um centro de custo (CENTRO) ou o balde
/// dos centros sem regra própria (RATEIO) — e um destino — uma linha, com 100% (LINHA), ou uma base por linha (BASE: o
/// volume das listas de cada linha, como o m³ produzido ou os dias de acompanhamento) —, com a vigência. Não entra na
/// apuração da DRE (não pede reapurar): só divide entre as linhas o que a DRE já deu a cada unidade.
model AlocacaoLinha {
  id             String         @id @default(uuid())
  /// CENTRO ou RATEIO.
  origem         String
  centroCustoId  String?        @map("centro_custo_id")
  balde          BaldeAlocacao?
  /// LINHA ou BASE.
  destino        String
  linhaId        String?        @map("linha_id")
  /// A base por linha (BASES_DAS_LINHAS, em definicoesCadastros.ts): M3_PRODUZIDO, M3_PROJETOS, KG_METALURGIA…
  base           String?
  vigenciaInicio DateTime       @map("vigencia_inicio")
  vigenciaFim    DateTime?      @map("vigencia_fim")
  ordem          Int            @default(0)
  criadoEm       DateTime       @default(now()) @map("criado_em")
  atualizadoEm   DateTime       @updatedAt @map("atualizado_em")

  centroCusto CentroCusto? @relation(fields: [centroCustoId], references: [id], onDelete: Cascade)
  linha       Linha?       @relation(fields: [linhaId], references: [id], onDelete: Restrict)

  @@index([centroCustoId])
  @@index([balde])
  @@map("alocacoes_linhas")
}

model CenarioReajuste {
  id          String   @id @default(uuid())
  cenarioId   String   @map("cenario_id")
  criadoEm    DateTime @default(now()) @map("criado_em")
  usuarioId   String?  @map("usuario_id")
  usuarioNome String   @map("usuario_nome")
  /// MARCADOS (o reajuste dos valores marcados), VALOR (a edição de um valor) ou REFERENCIA (a carga de um arquivo ou
  /// do resultado realizado).
  tipo        String
  /// PERCENTUAL, ABSOLUTO ou DIGITADO (o valor digitado direto); nulo na referência.
  modo        String?
  /// O reajuste informado: o percentual (5 = 5%) ou o valor somado; nulo no valor digitado e na referência.
  reajuste    Decimal?
  /// A visão da DRE (1 a 5); nula na referência.
  visao       Int?
  /// A edição de um valor replicada aos meses seguintes.
  replicado   Boolean  @default(false)
  /// As contas alteradas: [{ codigo, descricao }].
  contas      Json? @db.Json
  /// Os meses alterados (1 a 12).
  meses       Json? @db.Json
  valores     Int      @default(0)
  somaAntes   Decimal? @map("soma_antes")
  somaDepois  Decimal? @map("soma_depois")
  /// A descrição da referência carregada (o arquivo, ou o realizado e o período).
  descricao   String?

  cenario Cenario @relation(fields: [cenarioId], references: [id], onDelete: Cascade)

  @@index([cenarioId, criadoEm])
  @@map("cenarios_reajustes")
}

/// Um item de requisição do mês (aba Requisições (Lista) do LISTAS REALIZADO (RESULTADOS), 11/10/2026): o extrato de
/// uma conta na DRE abre as requisições e as notas fiscais da conta no mês. Não entra na apuração.
model RequisicaoItem {
  id                   String    @id @default(uuid())
  competenciaId        String    @map("competencia_id")
  importacaoId         String    @map("importacao_id")
  identificador        String?
  tipoMovimento        String?   @map("tipo_movimento")
  nomeTipoMovimento    String?   @map("nome_tipo_movimento")
  dataBaixa            DateTime? @map("data_baixa")
  filial               Int?
  /// O centro de custo pelo código RM, e o nome, como vieram.
  codigoCentroCusto    String?   @map("codigo_centro_custo")
  nomeCentroCusto      String?   @map("nome_centro_custo")
  projeto              String?
  tarefa               String?
  nomeTarefa           String?   @map("nome_tarefa")
  naturezaOrcamentaria String?   @map("natureza_orcamentaria")
  /// A conta contábil pelo código reduzido (o da Conta de Resultado).
  contaContabil        String    @map("conta_contabil")
  descricaoConta       String?   @map("descricao_conta")
  codigoProduto        String?   @map("codigo_produto")
  descricaoItem        String?   @map("descricao_item")
  quantidade           Decimal?
  contaEstoque         String?   @map("conta_estoque")
  valorUnitario        Decimal?  @map("valor_unitario")
  valorTotal           Decimal   @map("valor_total")
  linhaArquivo         Int       @map("linha_arquivo")

  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  importacao  Importacao  @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@index([competenciaId, contaContabil])
  @@index([importacaoId])
  @@map("requisicoes_itens")
}

/// Os colaboradores do mês num centro de custo (aba Quadro de Lotação do LISTAS REALIZADO (OPERAÇÃO), 19/10/2026): a
/// referência do quadro de lotação realizado por centro nos cenários analíticos. Não entra na apuração nem nos
/// indicadores de quadro de lotação do mês (esses seguem a aba Indicadores (Admin.)).
model LotacaoCentro {
  id            String  @id @default(uuid())
  competenciaId String  @map("competencia_id")
  importacaoId  String  @map("importacao_id")
  /// O centro de custo como veio na aba (o nome da controladoria: o grupo do cadastro Centros de Custo).
  centroCusto   String  @map("centro_custo")
  unidade       String?
  departamento  String?
  atribuicao    String?
  clt           Int
  pj            Int
  /// CLT + PJ.
  total         Int
  linhaArquivo  Int     @map("linha_arquivo")

  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  importacao  Importacao  @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@index([competenciaId])
  @@index([importacaoId])
  @@map("lotacoes_centros")
}

/// Um item de nota fiscal do mês (aba Notas Fiscais (Lista) do LISTAS REALIZADO (RESULTADOS), 11/10/2026).
model NotaFiscalItem {
  id                   String    @id @default(uuid())
  competenciaId        String    @map("competencia_id")
  importacaoId         String    @map("importacao_id")
  identificador        String?
  dataEmissao          DateTime? @map("data_emissao")
  dataSaida            DateTime? @map("data_saida")
  numero               String?
  filial               Int?
  codigoCentroCusto    String?   @map("codigo_centro_custo")
  nomeCentroCusto      String?   @map("nome_centro_custo")
  projeto              String?
  tarefa               String?
  nomeTarefa           String?   @map("nome_tarefa")
  codigoFornecedor     String?   @map("codigo_fornecedor")
  fornecedor           String?
  codigoProduto        String?   @map("codigo_produto")
  descricaoItem        String?   @map("descricao_item")
  quantidade           Decimal?
  subtotal             Decimal?
  desconto             Decimal?
  valorTotal           Decimal   @map("valor_total")
  cfop                 String?
  tipoMovimento        String?   @map("tipo_movimento")
  nomeTipoMovimento    String?   @map("nome_tipo_movimento")
  naturezaOrcamentaria String?   @map("natureza_orcamentaria")
  contaContabil        String    @map("conta_contabil")
  linhaArquivo         Int       @map("linha_arquivo")

  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  importacao  Importacao  @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@index([competenciaId, contaContabil])
  @@index([importacaoId])
  @@map("notas_fiscais_itens")
}

// -----------------------------------------------------------------------------
// Relatórios Executivos (15/10/2026)
// -----------------------------------------------------------------------------

/// ENUM: a situação de uma aba de um relatório executivo — em elaboração (só quem a edita a vê) ou finalizada (todos a veem, só leitura).
enum SituacaoRelatorio {
  EM_ELABORACAO
  FINALIZADO
}

/// Um relatório executivo (15/10/2026, Análises Gerenciais): a apresentação de uma competência fechada — um por mês —,
/// que os gestores montam juntos: uma aba por departamento (os sete), cada gestor nas abas do seu recorte (sem recorte,
/// todas). O relatório está finalizado quando todas as abas estão.
model RelatorioExecutivo {
  id            String                  @id @default(uuid())
  ano           Int
  mes           Int
  criadoPorId   String                  @map("criado_por_id")
  criadoPorNome String                  @map("criado_por_nome")
  criadoEm      DateTime                @default(now()) @map("criado_em")
  atualizadoEm  DateTime                @updatedAt @map("atualizado_em")
  /// O cenário de comparação dos cards e das tabelas (22/10/2026; a aba Configurações): sem ele, o cenário marcado como
  /// Orçamento Empresarial no exercício. Sem chave estrangeira: com o cenário excluído, volta à marcação.
  cenarioComparadoId String?               @map("cenario_comparado_id")
  abas          RelatorioExecutivoAba[]

  @@unique([ano, mes])
  @@map("relatorios_executivos")
}

/// Uma aba (um departamento) de um relatório executivo: os blocos da grade (os cards do Painel de Bordo, os dos
/// Indicadores e as anotações, com a posição e o tamanho de cada um) e a situação. Em elaboração, só quem a edita (e o
/// Administrador) a vê; finalizada, todos; quem a edita a finaliza e a reabre.
/// ENUM: as abas dos Relatórios Executivos (17/10/2026; antes, os sete departamentos): Fatos Relevantes e Demonstrativo
/// de Resultados (gerais: quem edita a tela) e as performances Comercial, da Produção, de Serviços e Administrativa (pelo
/// recorte de departamentos do usuário). A Capa (20/10/2026), geral, vem antes da Introdução (FATOS); os relatórios de
/// antes dela a ganham ao serem abertos (relatoriosExecutivosService.completarAbas).
enum AbaRelatorioExecutivo {
  CAPA
  FATOS
  RESULTADOS
  COMERCIAL
  PRODUCAO
  SERVICOS
  ADMINISTRATIVO
  /// O Encerramento (20/10/2026), geral como a Capa, depois das performances; os relatórios de antes dele o ganham ao
  /// serem abertos (completarAbas).
  ENCERRAMENTO
}

model RelatorioExecutivoAba {
  relatorioId   String             @map("relatorio_id")
  /// A aba (o nome da coluna ficou o de antes, departamento).
  departamento  AbaRelatorioExecutivo
  /// Os blocos: [{ id, tipo, x, y, w, h, … }].
  blocos        Json @db.Json
  situacao      SituacaoRelatorio  @default(EM_ELABORACAO)
  atualizadoPor String?            @map("atualizado_por")
  atualizadoEm  DateTime           @updatedAt @map("atualizado_em")
  finalizadoPor String?            @map("finalizado_por")
  finalizadoEm  DateTime?          @map("finalizado_em")

  relatorio RelatorioExecutivo @relation(fields: [relatorioId], references: [id], onDelete: Cascade)

  @@id([relatorioId, departamento])
  @@map("relatorios_executivos_abas")
}

/// O cadastro do Painel de Bordo (17/10/2026; Cadastros da Controladoria / Analítico / Painel de Bordo): os itens das
/// abas Resultados e Performance, cada um com o nome, a abreviação, o comportamento, o grupo (a aba), o quadro e o modelo
/// de apuração (a conta, no código: services/relatorios/painelDeBordo.ts, MODELOS_DO_PAINEL).
model PainelItem {
  id           String   @id @default(uuid())
  /// RESULTADOS | PERFORMANCE.
  grupo        String
  quadro       String
  nome         String
  sigla        String
  /// ↑ | ↓.
  sentido      String
  /// A Metodologia (17/10/2026; antes, a chave de um modelo de apuração fixo): a fórmula sobre os indicadores.
  formula      String
  /// MILHOES | MILHARES | M3 | PISTAS | PCT | PCT_RL | RS_M3.
  formato      String
  /// O formato do acumulado, quando é outro (nulo: o do mês).
  formatoAcumulado String? @map("formato_acumulado")
  /// O percentual sob o valor (/RL): uma fórmula; nulo, sem percentual.
  percentual   String?
  casasPercentual Int    @default(1) @map("casas_percentual")
  /// Um espaço antes do item (um novo bloco no quadro).
  separar      Boolean  @default(false)
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("painel_itens")
}

/// Os bloqueios da Biblioteca de APIs (24/10/2026, os controles deslizantes da tela): uma API (o código dela), um usuário
/// (o id) ou um endereço (o IP de quem chama) sem acesso às APIs. Sem a linha, liberado; desbloquear apaga a linha (a
/// Auditoria guarda quem bloqueou e desbloqueou, e quando).
model ApiBloqueio {
  id           String   @id @default(uuid())
  /// "API", "USUARIO" ou "ENDERECO".
  tipo         String
  valor        String
  bloqueadoPor String?  @map("bloqueado_por")
  bloqueadoEm  DateTime @default(now()) @map("bloqueado_em")

  @@unique([tipo, valor])
  @@map("api_bloqueios")
}
