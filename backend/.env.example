# Configuração do backend em três arquivos (15/10/2026: a separação da produção e do desenvolvimento).
# O carregamento (src/config/ambiente.ts e prisma.config.ts) lê primeiro o arquivo do modo e depois o .env comum.
# Sem NODE_ENV, o modo é desenvolvimento.

# ---------------------------------------------------------------------------------------------------------------
# backend/.env — comum aos dois ambientes
# ---------------------------------------------------------------------------------------------------------------
JWT_SECRET=use-uma-string-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
# Auditoria de negócio — persiste em audit_log se DATABASE_URL existir; senão log no console
ENABLE_AUDIT=true
# Arquivos importados — guardados pelo hash do conteúdo, fora do repositório
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=50
# TOTVS RM — SOAP (opcional; sem URL usa respostas mock no template)
# TOTVS_WSDL_URL=
# TOTVS_USER=
# TOTVS_PASSWORD=
# SQL Server — TOTVS RM (opcional)
# MSSQL_SERVER=
# MSSQL_DATABASE=
# MSSQL_USER=
# MSSQL_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------
# backend/.env.development — npm run dev (porta 3101), com a cópia do banco (npm run db:copiar-producao)
# ---------------------------------------------------------------------------------------------------------------
# PORT=3101
# DATABASE_URL=file:./prisma/desenvolvimento.db
# CORS_ORIGIN=http://localhost:3100
# ENABLE_SWAGGER=true

# ---------------------------------------------------------------------------------------------------------------
# backend/.env.production — npm run producao (porta 3001), com o banco real
# ---------------------------------------------------------------------------------------------------------------
# NODE_ENV=production
# PORT=3001
# DATABASE_URL=file:./prisma/dev.db
# CORS_ORIGIN=http://localhost:3000
# ENABLE_SWAGGER=false
