PORT=3001
# Desenvolvimento local: SQLite em arquivo. Produção: PostgreSQL.
# Ver backend/prisma/PORTABILIDADE.md antes de trocar.
DATABASE_URL=file:./prisma/dev.db
JWT_SECRET=use-uma-string-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d
ENABLE_TEMPLATE_AUTH=true
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000

# Swagger UI â€” true em dev; em produÃ§Ã£o, habilitar sÃ³ se TI autorizar (rede interna)
ENABLE_SWAGGER=true

# Auditoria de negÃ³cio â€” persiste em audit_log se DATABASE_URL existir; senÃ£o log no console
ENABLE_AUDIT=true

# TOTVS RM â€” SOAP (opcional; sem URL usa respostas mock no template)
# TOTVS_WSDL_URL=
# TOTVS_USER=
# TOTVS_PASSWORD=

# SQL Server â€” TOTVS RM (opcional)
# MSSQL_SERVER=
# MSSQL_DATABASE=
# MSSQL_USER=
# MSSQL_PASSWORD=
