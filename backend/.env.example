PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bpm_template
JWT_SECRET=use-uma-string-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d
ENABLE_TEMPLATE_AUTH=true
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000

# Swagger UI — true em dev; em produção, habilitar só se TI autorizar (rede interna)
ENABLE_SWAGGER=true

# Auditoria de negócio — persiste em audit_log se DATABASE_URL existir; senão log no console
ENABLE_AUDIT=true

# TOTVS RM — SOAP (opcional; sem URL usa respostas mock no template)
# TOTVS_WSDL_URL=
# TOTVS_USER=
# TOTVS_PASSWORD=

# SQL Server — TOTVS RM (opcional)
# MSSQL_SERVER=
# MSSQL_DATABASE=
# MSSQL_USER=
# MSSQL_PASSWORD=
