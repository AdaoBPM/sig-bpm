# Monorepo BPM — copie os envs abaixo para cada pasta

# Na raiz:
#   npm run setup    ← cria frontend/.env.local e backend/.env a partir dos .env.example
#   npm install
#   npm run dev

# Frontend (Next.js) — frontend/.env.local
# BACKEND_URL=http://localhost:3001

# Backend (Express) — backend/.env
# PORT=3001
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bpm_template
# JWT_SECRET=use-uma-string-aleatoria-com-pelo-menos-32-caracteres
# ENABLE_TEMPLATE_AUTH=false
# REDIS_URL=redis://localhost:6379
# CORS_ORIGIN=http://localhost:3000
